      "entry_type": "command",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Calculator</title>\n<style>\nbody {\nmargin: 0;\nmin-height: 100vh;\ndisplay: flex;\nalign-items: center;\njustify-content: center;\nbackground: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\nfont-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n}\n.calculator {\nbackground: rgba(255, 255, 255, 0.1);\nbackdrop-filter: blur(10px);\nborder-radius: 20px;\npadding: 20px;\nbox-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);\nwidth: 280px;\n}\n.display {\nbackground: rgba(0, 0, 0, 0.25);\ncolor: #fff;\nfont-size: 2rem;\ntext-align: right;\npadding: 15px;\nborder-radius: 10px;\nmargin-bottom: 15px;\noverflow: hidden;\nmin-height: 2.5rem;\nword-break: break-all;\n}\n.buttons {\ndisplay: grid;\ngrid-template-columns: repeat(4, 1fr);\ngap: 10px;\n}\nbutton {\nborder: none;\nborder-radius: 10px;\npadding: 18px 0;\nfont-size: 1.2rem;\ncursor: pointer;\nbackground: rgba(255, 255, 255, 0.2);\ncolor: #fff;\ntransition: background 0.2s, transform 0.1s;\n}\nbutton:hover {\nbackground: rgba(255, 255, 255, 0.35);\n}\nbutton:active {\ntransform: scale(0.95);\n}\n.operator {\nbackground: rgba(255, 159, 67, 0.8);\n}\n.operator:hover {\nbackground: rgba(255, 159, 67, 1);\n}\n.clear {\nbackground: rgba(255, 99, 132, 0.8);\n}\n.clear:hover {\nbackground: rgba(255, 99, 132, 1);\n}\n.equals {\nbackground: rgba(75, 207, 250, 0.8);\ngrid-column: span 2;\n}\n.equals:hover {\nbackground: rgba(75, 207, 250, 1);\n}\n.zero {\ngrid-column: span 2;\n}\n</style>\n</head>\n<body>\n<div class=\"calculator\">\n<div class=\"display\" id=\"display\">0</div>\n<div class=\"buttons\">\n<button class=\"clear\" data-action=\"clear\">C</button>\n<button class=\"operator\" data-op=\"/\">/</button>\n<button class=\"operator\" data-op=\"*\">*</button>\n<button class=\"operator\" data-op=\"-\">-</button>\n<button data-num=\"7\">7</button>\n<button data-num=\"8\">8</button>\n<button data-num=\"9\">9</button>\n<button class=\"operator\" data-op=\"+\">+</button>\n<button data-num=\"4\">4</button>\n<button data-num=\"5\">5</button>\n<button data-num=\"6\">6</button>\n<button data-num=\"1\">1</button>\n<button data-num=\"2\">2</button>\n<button data-num=\"3\">3</button>\n<button data-num=\"0\" class=\"zero\">0</button>\n<button data-dot=\".\">.</button>\n<button class=\"equals\" data-action=\"equals\">=</button>\n</div>\n</div>\n<script>\n(function () {\nvar display = document.getElementById('display');\nvar current = '0';\nvar justEvaluated = false;\nfunction updateDisplay() {\ndisplay.textContent = current;\n}\nfunction isOperator(ch) {\nreturn ch === '+' || ch === '-' || ch === '*' || ch === '/';\n}\n// Safe expression evaluator: no eval / no Function\nfunction safeEvaluate(expr) {\nvar tokens = [];\nvar num = '';\nfor (var i = 0; i < expr.length; i++) {\nvar ch = expr[i];\nif ((ch >= '0' && ch <= '9') || ch === '.') {\nnum += ch;\n} else if (isOperator(ch)) {\nif (num === '') {\nif (ch === '-' && (i === 0 || isOperator(expr[i - 1]))) {\nnum = '-';\ncontinue;\n} else {\nreturn 'Error';\n}\n}\ntokens.push(parseFloat(num));\ntokens.push(ch);\nnum = '';\n} else {\nreturn 'Error';\n}\n}\nif (num === '' || num === '-') return 'Error';\ntokens.push(parseFloat(num));\n// First pass: * and /\nvar reduced = [];\nvar j = 0;\nwhile (j < tokens.length) {\nif (typeof tokens[j] === 'number') {\nif (reduced.length > 0 && typeof reduced[reduced.length - 1] === 'string' &&\n(reduced[reduced.length - 1] === '*' || reduced[reduced.length - 1] === '/')) {\nvar op = reduced.pop();\nvar left = reduced.pop();\nvar right = tokens[j];\nif (op === '/') {\nif (right === 0) return 'Error';\nreduced.push(left / right);\n} else {\nreduced.push(left * right);\n}\n} else {\nreduced.push(tokens[j]);\n}\n} else {\nreduced.push(tokens[j]);\n}\nj++;\n}\n// Second pass: + and -\nvar result = reduced[0];\nfor (var k = 1; k < reduced.length; k += 2) {\nvar oper = reduced[k];\nvar val = reduced[k + 1];\nif (oper === '+') result += val;\nelse if (oper === '-') result -= val;\nelse return 'Error';\n}\nreturn result;\n}\nfunction handleNumber(num) {\nif (justEvaluated) {\ncurrent = num;\njustEvaluated = false;\n} else {\nif (current === '0') current = num;\nelse current += num;\n}\nupdateDisplay();\n}\nfunction handleDot() {\nif (justEvaluated) {\ncurrent = '0.';\njustEvaluated = false;\n} else {\nvar parts = current.split(/[\\+\\-\\*\\/]/);\nvar last = parts[parts.length - 1];\nif (last.indexOf('.') === -1) {\ncurrent += '.';\n}\n}\nupdateDisplay();\n}\nfunction handleOperator(op) {\nif (justEvaluated) {\njustEvaluated = false;\n}\nif (current === '' || current === '-') return;\nvar lastChar = current[current.length - 1];\nif (isOperator(lastChar)) {\ncurrent = current.slice(0, -1) + op;\n} else {\ncurrent += op;\n}\nupdateDisplay();\n}\nfunction handleClear() {\ncurrent = '0';\njustEvaluated = false;\nupdateDisplay();\n}\nfunction handleEquals() {\nvar lastChar = current[current.length - 1];\nif (isOperator(lastChar) || current === '' || current === '-') {\nreturn;\n}\nvar res = safeEvaluate(current);\nif (res === 'Error') {\ncurrent = 'Error';\n} else {\nif (!isFinite(res)) {\ncurrent = 'Error';\n} else {\ncurrent = String(res);\n}\n}\njustEvaluated = true;\nupdateDisplay();\n}\ndocument.querySelectorAll('button').forEach(function (btn) {\nbtn.addEventListener('click', function () {\nif (btn.dataset.num !== undefined) handleNumber(btn.dataset.num);\nelse if (btn.dataset.dot !== undefined) handleDot();\nelse if (btn.dataset.op !== undefined) handleOperator(btn.dataset.op);\nelse if (btn.dataset.action === 'clear') handleClear();\nelse if (btn.dataset.action === 'equals') handleEquals();\n});\n});\nupdateDisplay();\n})();\n</script>\n</body>\n</html>",
      "command": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Calculator</title>\n<style>\nbody {\nmargin: 0;\nmin-height: 100vh;\ndisplay: flex;\nalign-items: center;\njustify-content: center;\nbackground: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\nfont-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n}\n.calculator {\nbackground: rgba(255, 255, 255, 0.1);\nbackdrop-filter: blur(10px);\nborder-radius: 20px;\npadding: 20px;\nbox-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);\nwidth: 280px;\n}\n.display {\nbackground: rgba(0, 0, 0, 0.25);\ncolor: #fff;\nfont-size: 2rem;\ntext-align: right;\npadding: 15px;\nborder-radius: 10px;\nmargin-bottom: 15px;\noverflow: hidden;\nmin-height: 2.5rem;\nword-break: break-all;\n}\n.buttons {\ndisplay: grid;\ngrid-template-columns: repeat(4, 1fr);\ngap: 10px;\n}\nbutton {\nborder: none;\nborder-radius: 10px;\npadding: 18px 0;\nfont-size: 1.2rem;\ncursor: pointer;\nbackground: rgba(255, 255, 255, 0.2);\ncolor: #fff;\ntransition: background 0.2s, transform 0.1s;\n}\nbutton:hover {\nbackground: rgba(255, 255, 255, 0.35);\n}\nbutton:active {\ntransform: scale(0.95);\n}\n.operator {\nbackground: rgba(255, 159, 67, 0.8);\n}\n.operator:hover {\nbackground: rgba(255, 159, 67, 1);\n}\n.clear {\nbackground: rgba(255, 99, 132, 0.8);\n}\n.clear:hover {\nbackground: rgba(255, 99, 132, 1);\n}\n.equals {\nbackground: rgba(75, 207, 250, 0.8);\ngrid-column: span 2;\n}\n.equals:hover {\nbackground: rgba(75, 207, 250, 1);\n}\n.zero {\ngrid-column: span 2;\n}\n</style>\n</head>\n<body>\n<div class=\"calculator\">\n<div class=\"display\" id=\"display\">0</div>\n<div class=\"buttons\">\n<button class=\"clear\" data-action=\"clear\">C</button>\n<button class=\"operator\" data-op=\"/\">/</button>\n<button class=\"operator\" data-op=\"*\">*</button>\n<button class=\"operator\" data-op=\"-\">-</button>\n<button data-num=\"7\">7</button>\n<button data-num=\"8\">8</button>\n<button data-num=\"9\">9</button>\n<button class=\"operator\" data-op=\"+\">+</button>\n<button data-num=\"4\">4</button>\n<button data-num=\"5\">5</button>\n<button data-num=\"6\">6</button>\n<button data-num=\"1\">1</button>\n<button data-num=\"2\">2</button>\n<button data-num=\"3\">3</button>\n<button data-num=\"0\" class=\"zero\">0</button>\n<button data-dot=\".\">.</button>\n<button class=\"equals\" data-action=\"equals\">=</button>\n</div>\n</div>\n<script>\n(function () {\nvar display = document.getElementById('display');\nvar current = '0';\nvar justEvaluated = false;\nfunction updateDisplay() {\ndisplay.textContent = current;\n}\nfunction isOperator(ch) {\nreturn ch === '+' || ch === '-' || ch === '*' || ch === '/';\n}\n// Safe expression evaluator: no eval / no Function\nfunction safeEvaluate(expr) {\nvar tokens = [];\nvar num = '';\nfor (var i = 0; i < expr.length; i++) {\nvar ch = expr[i];\nif ((ch >= '0' && ch <= '9') || ch === '.') {\nnum += ch;\n} else if (isOperator(ch)) {\nif (num === '') {\nif (ch === '-' && (i === 0 || isOperator(expr[i - 1]))) {\nnum = '-';\ncontinue;\n} else {\nreturn 'Error';\n}\n}\ntokens.push(parseFloat(num));\ntokens.push(ch);\nnum = '';\n} else {\nreturn 'Error';\n}\n}\nif (num === '' || num === '-') return 'Error';\ntokens.push(parseFloat(num));\n// First pass: * and /\nvar reduced = [];\nvar j = 0;\nwhile (j < tokens.length) {\nif (typeof tokens[j] === 'number') {\nif (reduced.length > 0 && typeof reduced[reduced.length - 1] === 'string' &&\n(reduced[reduced.length - 1] === '*' || reduced[reduced.length - 1] === '/')) {\nvar op = reduced.pop();\nvar left = reduced.pop();\nvar right = tokens[j];\nif (op === '/') {\nif (right === 0) return 'Error';\nreduced.push(left / right);\n} else {\nreduced.push(left * right);\n}\n} else {\nreduced.push(tokens[j]);\n}\n} else {\nreduced.push(tokens[j]);\n}\nj++;\n}\n// Second pass: + and -\nvar result = reduced[0];\nfor (var k = 1; k < reduced.length; k += 2) {\nvar oper = reduced[k];\nvar val = reduced[k + 1];\nif (oper === '+') result += val;\nelse if (oper === '-') result -= val;\nelse return 'Error';\n}\nreturn result;\n}\nfunction handleNumber(num) {\nif (justEvaluated) {\ncurrent = num;\njustEvaluated = false;\n} else {\nif (current === '0') current = num;\nelse current += num;\n}\nupdateDisplay();\n}\nfunction handleDot() {\nif (justEvaluated) {\ncurrent = '0.';\njustEvaluated = false;\n} else {\nvar parts = current.split(/[\\+\\-\\*\\/]/);\nvar last = parts[parts.length - 1];\nif (last.indexOf('.') === -1) {\ncurrent += '.';\n}\n}\nupdateDisplay();\n}\nfunction handleOperator(op) {\nif (justEvaluated) {\njustEvaluated = false;\n}\nif (current === '' || current === '-') return;\nvar lastChar = current[current.length - 1];\nif (isOperator(lastChar)) {\ncurrent = current.slice(0, -1) + op;\n} else {\ncurrent += op;\n}\nupdateDisplay();\n}\nfunction handleClear() {\ncurrent = '0';\njustEvaluated = false;\nupdateDisplay();\n}\nfunction handleEquals() {\nvar lastChar = current[current.length - 1];\nif (isOperator(lastChar) || current === '' || current === '-') {\nreturn;\n}\nvar res = safeEvaluate(current);\nif (res === 'Error') {\ncurrent = 'Error';\n} else {\nif (!isFinite(res)) {\ncurrent = 'Error';\n} else {\ncurrent = String(res);\n}\n}\njustEvaluated = true;\nupdateDisplay();\n}\ndocument.querySelectorAll('button').forEach(function (btn) {\nbtn.addEventListener('click', function () {\nif (btn.dataset.num !== undefined) handleNumber(btn.dataset.num);\nelse if (btn.dataset.dot !== undefined) handleDot();\nelse if (btn.dataset.op !== undefined) handleOperator(btn.dataset.op);\nelse if (btn.dataset.action === 'clear') handleClear();\nelse if (btn.dataset.action === 'equals') handleEquals();\n});\n});\nupdateDisplay();\n})();\n</script>\n</body>\n</html>",
