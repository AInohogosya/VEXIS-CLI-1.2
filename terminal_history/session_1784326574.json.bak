      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Calculator</title>\n<style>\n* { box-sizing: border-box; margin: 0; padding: 0; }\nbody {\nmin-height: 100vh;\ndisplay: flex;\nalign-items: center;\njustify-content: center;\nbackground: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\nfont-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n}\n.calculator {\nbackground: rgba(255, 255, 255, 0.1);\nbackdrop-filter: blur(10px);\nborder-radius: 20px;\npadding: 20px;\nbox-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);\nwidth: 320px;\n}\n.display {\nbackground: rgba(0, 0, 0, 0.25);\ncolor: #fff;\nfont-size: 2rem;\ntext-align: right;\npadding: 15px;\nborder-radius: 10px;\nmargin-bottom: 15px;\nmin-height: 60px;\noverflow-x: auto;\nword-break: break-all;\n}\n.buttons {\ndisplay: grid;\ngrid-template-columns: repeat(4, 1fr);\ngap: 10px;\n}\nbutton {\nborder: none;\nborder-radius: 10px;\npadding: 18px 0;\nfont-size: 1.3rem;\ncursor: pointer;\nbackground: rgba(255, 255, 255, 0.2);\ncolor: #fff;\ntransition: background 0.2s, transform 0.1s;\n}\nbutton:hover { background: rgba(255, 255, 255, 0.35); }\nbutton:active { transform: scale(0.95); }\n.operator { background: rgba(255, 165, 0, 0.6); }\n.operator:hover { background: rgba(255, 165, 0, 0.8); }\n.clear { background: rgba(220, 20, 60, 0.6); }\n.clear:hover { background: rgba(220, 20, 60, 0.8); }\n.equals { background: rgba(46, 204, 113, 0.6); grid-column: span 2; }\n.equals:hover { background: rgba(46, 204, 113, 0.8); }\n.zero { grid-column: span 2; }\n</style>\n</head>\n<body>\n<div class=\"calculator\">\n<div class=\"display\" id=\"display\">0</div>\n<div class=\"buttons\">\n<button class=\"clear\" data-action=\"clear\">C</button>\n<button class=\"operator\" data-value=\"/\">/</button>\n<button class=\"operator\" data-value=\"*\">*</button>\n<button class=\"operator\" data-value=\"-\">-</button>\n<button data-value=\"7\">7</button>\n<button data-value=\"8\">8</button>\n<button data-value=\"9\">9</button>\n<button class=\"operator\" data-value=\"+\">+</button>\n<button data-value=\"4\">4</button>\n<button data-value=\"5\">5</button>\n<button data-value=\"6\">6</button>\n<button data-value=\"1\">1</button>\n<button data-value=\"2\">2</button>\n<button data-value=\"3\">3</button>\n<button data-value=\"0\" class=\"zero\">0</button>\n<button data-value=\".\">.</button>\n<button class=\"equals\" data-action=\"equals\">=</button>\n</div>\n</div>\n<script>\n(function() {\nvar display = document.getElementById('display');\nvar current = '0';\nvar justEvaluated = false;\nfunction updateDisplay() {\ndisplay.textContent = current;\n}\nfunction isOperator(ch) {\nreturn ch === '+' || ch === '-' || ch === '*' || ch === '/';\n}\n// Safe expression evaluator: tokenizes and computes without eval/Function\nfunction safeEvaluate(expr) {\nvar tokens = [];\nvar i = 0;\nwhile (i < expr.length) {\nvar ch = expr[i];\nif (isOperator(ch)) {\ntokens.push({ type: 'op', value: ch });\ni++;\n} else if (ch >= '0' && ch <= '9' || ch === '.') {\nvar num = '';\nwhile (i < expr.length && (expr[i] >= '0' && expr[i] <= '9' || expr[i] === '.')) {\nnum += expr[i];\ni++;\n}\ntokens.push({ type: 'num', value: parseFloat(num) });\n} else {\ni++; // skip invalid chars\n}\n}\nif (tokens.length === 0) return 0;\n// First pass: * and /\nvar newTokens = [];\nvar j = 0;\nwhile (j < tokens.length) {\nif (tokens[j].type === 'num') {\nif (j + 1 < tokens.length && tokens[j+1].type === 'op' &&\n(tokens[j+1].value === '*' || tokens[j+1].value === '/')) {\nvar left = tokens[j].value;\nvar op = tokens[j+1].value;\nvar right = tokens[j+2].value;\nif (op === '/' && right === 0) return 'Error';\nvar res = op === '*' ? left * right : left / right;\nnewTokens.push({ type: 'num', value: res });\nj += 3;\n} else {\nnewTokens.push(tokens[j]);\nj++;\n}\n} else {\nnewTokens.push(tokens[j]);\nj++;\n}\n}\n// Second pass: + and -\nvar result = newTokens[0].value;\nvar k = 1;\nwhile (k < newTokens.length) {\nvar oper = newTokens[k].value;\nvar val = newTokens[k+1].value;\nif (oper === '+') result += val;\nelse if (oper === '-') result -= val;\nk += 2;\n}\nreturn result;\n}\nfunction handleValue(val) {\nif (justEvaluated) {\nif (isOperator(val)) {\ncurrent = current + val;\n} else if (val === '.') {\ncurrent = '0.';\n} else {\ncurrent = val;\n}\njustEvaluated = false;\nupdateDisplay();\nreturn;\n}\nif (current === '0' && val !== '.') {\nif (isOperator(val)) {\ncurrent = current + val;\n} else {\ncurrent = val;\n}\n} else {\nvar lastChar = current[current.length - 1];\nif (isOperator(val) && isOperator(lastChar)) {\ncurrent = current.slice(0, -1) + val; // replace consecutive operator\n} else if (val === '.' && lastChar === '.') {\n// ignore extra decimal point\n} else if (val === '.' && /(\\d*\\.\\d*)$/.test(current.split(/[+\\-*/]/).pop())) {\n// ignore if current number already has decimal\n} else {\ncurrent += val;\n}\n}\nupdateDisplay();\n}\nfunction handleClear() {\ncurrent = '0';\njustEvaluated = false;\nupdateDisplay();\n}\nfunction handleEquals() {\nvar result = safeEvaluate(current);\nif (result === 'Error') {\ncurrent = 'Error';\n} else {\ncurrent = String(result);\n}\njustEvaluated = true;\nupdateDisplay();\n}\ndocument.querySelectorAll('button').forEach(function(btn) {\nbtn.addEventListener('click', function() {\nvar action = btn.getAttribute('data-action');\nvar value = btn.getAttribute('data-value');\nif (action === 'clear') handleClear();\nelse if (action === 'equals') handleEquals();\nelse if (value) handleValue(value);\n});\n});\nupdateDisplay();\n})();\n</script>\n</body>\n</html>",
      "command": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Calculator</title>\n<style>\n* { box-sizing: border-box; margin: 0; padding: 0; }\nbody {\nmin-height: 100vh;\ndisplay: flex;\nalign-items: center;\njustify-content: center;\nbackground: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\nfont-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n}\n.calculator {\nbackground: rgba(255, 255, 255, 0.1);\nbackdrop-filter: blur(10px);\nborder-radius: 20px;\npadding: 20px;\nbox-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);\nwidth: 320px;\n}\n.display {\nbackground: rgba(0, 0, 0, 0.25);\ncolor: #fff;\nfont-size: 2rem;\ntext-align: right;\npadding: 15px;\nborder-radius: 10px;\nmargin-bottom: 15px;\nmin-height: 60px;\noverflow-x: auto;\nword-break: break-all;\n}\n.buttons {\ndisplay: grid;\ngrid-template-columns: repeat(4, 1fr);\ngap: 10px;\n}\nbutton {\nborder: none;\nborder-radius: 10px;\npadding: 18px 0;\nfont-size: 1.3rem;\ncursor: pointer;\nbackground: rgba(255, 255, 255, 0.2);\ncolor: #fff;\ntransition: background 0.2s, transform 0.1s;\n}\nbutton:hover { background: rgba(255, 255, 255, 0.35); }\nbutton:active { transform: scale(0.95); }\n.operator { background: rgba(255, 165, 0, 0.6); }\n.operator:hover { background: rgba(255, 165, 0, 0.8); }\n.clear { background: rgba(220, 20, 60, 0.6); }\n.clear:hover { background: rgba(220, 20, 60, 0.8); }\n.equals { background: rgba(46, 204, 113, 0.6); grid-column: span 2; }\n.equals:hover { background: rgba(46, 204, 113, 0.8); }\n.zero { grid-column: span 2; }\n</style>\n</head>\n<body>\n<div class=\"calculator\">\n<div class=\"display\" id=\"display\">0</div>\n<div class=\"buttons\">\n<button class=\"clear\" data-action=\"clear\">C</button>\n<button class=\"operator\" data-value=\"/\">/</button>\n<button class=\"operator\" data-value=\"*\">*</button>\n<button class=\"operator\" data-value=\"-\">-</button>\n<button data-value=\"7\">7</button>\n<button data-value=\"8\">8</button>\n<button data-value=\"9\">9</button>\n<button class=\"operator\" data-value=\"+\">+</button>\n<button data-value=\"4\">4</button>\n<button data-value=\"5\">5</button>\n<button data-value=\"6\">6</button>\n<button data-value=\"1\">1</button>\n<button data-value=\"2\">2</button>\n<button data-value=\"3\">3</button>\n<button data-value=\"0\" class=\"zero\">0</button>\n<button data-value=\".\">.</button>\n<button class=\"equals\" data-action=\"equals\">=</button>\n</div>\n</div>\n<script>\n(function() {\nvar display = document.getElementById('display');\nvar current = '0';\nvar justEvaluated = false;\nfunction updateDisplay() {\ndisplay.textContent = current;\n}\nfunction isOperator(ch) {\nreturn ch === '+' || ch === '-' || ch === '*' || ch === '/';\n}\n// Safe expression evaluator: tokenizes and computes without eval/Function\nfunction safeEvaluate(expr) {\nvar tokens = [];\nvar i = 0;\nwhile (i < expr.length) {\nvar ch = expr[i];\nif (isOperator(ch)) {\ntokens.push({ type: 'op', value: ch });\ni++;\n} else if (ch >= '0' && ch <= '9' || ch === '.') {\nvar num = '';\nwhile (i < expr.length && (expr[i] >= '0' && expr[i] <= '9' || expr[i] === '.')) {\nnum += expr[i];\ni++;\n}\ntokens.push({ type: 'num', value: parseFloat(num) });\n} else {\ni++; // skip invalid chars\n}\n}\nif (tokens.length === 0) return 0;\n// First pass: * and /\nvar newTokens = [];\nvar j = 0;\nwhile (j < tokens.length) {\nif (tokens[j].type === 'num') {\nif (j + 1 < tokens.length && tokens[j+1].type === 'op' &&\n(tokens[j+1].value === '*' || tokens[j+1].value === '/')) {\nvar left = tokens[j].value;\nvar op = tokens[j+1].value;\nvar right = tokens[j+2].value;\nif (op === '/' && right === 0) return 'Error';\nvar res = op === '*' ? left * right : left / right;\nnewTokens.push({ type: 'num', value: res });\nj += 3;\n} else {\nnewTokens.push(tokens[j]);\nj++;\n}\n} else {\nnewTokens.push(tokens[j]);\nj++;\n}\n}\n// Second pass: + and -\nvar result = newTokens[0].value;\nvar k = 1;\nwhile (k < newTokens.length) {\nvar oper = newTokens[k].value;\nvar val = newTokens[k+1].value;\nif (oper === '+') result += val;\nelse if (oper === '-') result -= val;\nk += 2;\n}\nreturn result;\n}\nfunction handleValue(val) {\nif (justEvaluated) {\nif (isOperator(val)) {\ncurrent = current + val;\n} else if (val === '.') {\ncurrent = '0.';\n} else {\ncurrent = val;\n}\njustEvaluated = false;\nupdateDisplay();\nreturn;\n}\nif (current === '0' && val !== '.') {\nif (isOperator(val)) {\ncurrent = current + val;\n} else {\ncurrent = val;\n}\n} else {\nvar lastChar = current[current.length - 1];\nif (isOperator(val) && isOperator(lastChar)) {\ncurrent = current.slice(0, -1) + val; // replace consecutive operator\n} else if (val === '.' && lastChar === '.') {\n// ignore extra decimal point\n} else if (val === '.' && /(\\d*\\.\\d*)$/.test(current.split(/[+\\-*/]/).pop())) {\n// ignore if current number already has decimal\n} else {\ncurrent += val;\n}\n}\nupdateDisplay();\n}\nfunction handleClear() {\ncurrent = '0';\njustEvaluated = false;\nupdateDisplay();\n}\nfunction handleEquals() {\nvar result = safeEvaluate(current);\nif (result === 'Error') {\ncurrent = 'Error';\n} else {\ncurrent = String(result);\n}\njustEvaluated = true;\nupdateDisplay();\n}\ndocument.querySelectorAll('button').forEach(function(btn) {\nbtn.addEventListener('click', function() {\nvar action = btn.getAttribute('data-action');\nvar value = btn.getAttribute('data-value');\nif (action === 'clear') handleClear();\nelse if (action === 'equals') handleEquals();\nelse if (value) handleValue(value);\n});\n});\nupdateDisplay();\n})();\n</script>\n</body>\n</html>",
