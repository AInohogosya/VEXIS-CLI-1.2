      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Calculator</title>\n<style>\n* { box-sizing: border-box; }\nbody {\nmargin: 0;\nmin-height: 100vh;\ndisplay: flex;\nalign-items: center;\njustify-content: center;\nbackground: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\nfont-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n}\n.calculator {\nbackground: #ffffff;\nborder-radius: 16px;\nbox-shadow: 0 10px 40px rgba(0,0,0,0.2);\npadding: 20px;\nwidth: 300px;\n}\n.display {\nwidth: 100%;\nheight: 60px;\nborder: none;\nborder-radius: 10px;\nbackground: #f3f4f6;\nfont-size: 28px;\ntext-align: right;\npadding: 0 15px;\nmargin-bottom: 15px;\ncolor: #111827;\n}\n.buttons {\ndisplay: grid;\ngrid-template-columns: repeat(4, 1fr);\ngap: 10px;\n}\nbutton {\nheight: 55px;\nborder: none;\nborder-radius: 10px;\nfont-size: 20px;\ncursor: pointer;\nbackground: #e5e7eb;\ncolor: #1f2937;\ntransition: background 0.15s, transform 0.05s;\n}\nbutton:hover { background: #d1d5db; }\nbutton:active { transform: scale(0.96); }\n.operator { background: #667eea; color: #fff; }\n.operator:hover { background: #556cd6; }\n.equals { background: #10b981; color: #fff; grid-column: span 2; }\n.equals:hover { background: #059669; }\n.clear { background: #ef4444; color: #fff; }\n.clear:hover { background: #dc2626; }\n</style>\n</head>\n<body>\n<div class=\"calculator\">\n<input type=\"text\" class=\"display\" id=\"display\" readonly value=\"0\">\n<div class=\"buttons\">\n<button class=\"clear\" onclick=\"clearDisplay()\">C</button>\n<button class=\"operator\" onclick=\"appendOperator('/')\">/</button>\n<button class=\"operator\" onclick=\"appendOperator('*')\">*</button>\n<button onclick=\"appendDigit('7')\">7</button>\n<button onclick=\"appendDigit('8')\">8</button>\n<button onclick=\"appendDigit('9')\">9</button>\n<button class=\"operator\" onclick=\"appendOperator('-')\">-</button>\n<button onclick=\"appendDigit('4')\">4</button>\n<button onclick=\"appendDigit('5')\">5</button>\n<button onclick=\"appendDigit('6')\">6</button>\n<button class=\"operator\" onclick=\"appendOperator('+')\">+</button>\n<button onclick=\"appendDigit('1')\">1</button>\n<button onclick=\"appendDigit('2')\">2</button>\n<button onclick=\"appendDigit('3')\">3</button>\n<button onclick=\"appendDigit('0')\">0</button>\n<button onclick=\"appendDigit('.')\">.</button>\n<button class=\"equals\" onclick=\"calculate()\">=</button>\n</div>\n</div>\n<script>\nconst display = document.getElementById('display');\nlet current = '0';\nlet shouldReset = false;\nfunction updateDisplay() {\ndisplay.value = current;\n}\nfunction appendDigit(d) {\nif (shouldReset) {\ncurrent = (d === '.') ? '0.' : d;\nshouldReset = false;\n} else {\nif (current === '0' && d !== '.') current = d;\nelse if (d === '.' && current.includes('.')) return;\nelse current += d;\n}\nupdateDisplay();\n}\nfunction appendOperator(op) {\nif (shouldReset) shouldReset = false;\nif (current === '0' && op === '-') {\ncurrent = '-';\n} else if (/[+\\-*/]$/.test(current)) {\ncurrent = current.slice(0, -1) + op;\n} else {\ncurrent += op;\n}\nupdateDisplay();\n}\nfunction clearDisplay() {\ncurrent = '0';\nshouldReset = false;\nupdateDisplay();\n}\nfunction calculate() {\ntry {\nlet expr = current.replace(/[^0-9+\\-*/.]/g, '');\nif (/[+\\-*/]$/.test(expr)) expr = expr.slice(0, -1);\nlet result = Function('\"use strict\"; return (' + expr + ')')();\nif (!isFinite(result)) throw new Error('Bad');\ncurrent = String(result);\nshouldReset = true;\nupdateDisplay();\n} catch (e) {\ncurrent = 'Error';\nshouldReset = true;\nupdateDisplay();\n}\n}\n</script>\n</body>\n</html>",
      "command": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Calculator</title>\n<style>\n* { box-sizing: border-box; }\nbody {\nmargin: 0;\nmin-height: 100vh;\ndisplay: flex;\nalign-items: center;\njustify-content: center;\nbackground: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\nfont-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n}\n.calculator {\nbackground: #ffffff;\nborder-radius: 16px;\nbox-shadow: 0 10px 40px rgba(0,0,0,0.2);\npadding: 20px;\nwidth: 300px;\n}\n.display {\nwidth: 100%;\nheight: 60px;\nborder: none;\nborder-radius: 10px;\nbackground: #f3f4f6;\nfont-size: 28px;\ntext-align: right;\npadding: 0 15px;\nmargin-bottom: 15px;\ncolor: #111827;\n}\n.buttons {\ndisplay: grid;\ngrid-template-columns: repeat(4, 1fr);\ngap: 10px;\n}\nbutton {\nheight: 55px;\nborder: none;\nborder-radius: 10px;\nfont-size: 20px;\ncursor: pointer;\nbackground: #e5e7eb;\ncolor: #1f2937;\ntransition: background 0.15s, transform 0.05s;\n}\nbutton:hover { background: #d1d5db; }\nbutton:active { transform: scale(0.96); }\n.operator { background: #667eea; color: #fff; }\n.operator:hover { background: #556cd6; }\n.equals { background: #10b981; color: #fff; grid-column: span 2; }\n.equals:hover { background: #059669; }\n.clear { background: #ef4444; color: #fff; }\n.clear:hover { background: #dc2626; }\n</style>\n</head>\n<body>\n<div class=\"calculator\">\n<input type=\"text\" class=\"display\" id=\"display\" readonly value=\"0\">\n<div class=\"buttons\">\n<button class=\"clear\" onclick=\"clearDisplay()\">C</button>\n<button class=\"operator\" onclick=\"appendOperator('/')\">/</button>\n<button class=\"operator\" onclick=\"appendOperator('*')\">*</button>\n<button onclick=\"appendDigit('7')\">7</button>\n<button onclick=\"appendDigit('8')\">8</button>\n<button onclick=\"appendDigit('9')\">9</button>\n<button class=\"operator\" onclick=\"appendOperator('-')\">-</button>\n<button onclick=\"appendDigit('4')\">4</button>\n<button onclick=\"appendDigit('5')\">5</button>\n<button onclick=\"appendDigit('6')\">6</button>\n<button class=\"operator\" onclick=\"appendOperator('+')\">+</button>\n<button onclick=\"appendDigit('1')\">1</button>\n<button onclick=\"appendDigit('2')\">2</button>\n<button onclick=\"appendDigit('3')\">3</button>\n<button onclick=\"appendDigit('0')\">0</button>\n<button onclick=\"appendDigit('.')\">.</button>\n<button class=\"equals\" onclick=\"calculate()\">=</button>\n</div>\n</div>\n<script>\nconst display = document.getElementById('display');\nlet current = '0';\nlet shouldReset = false;\nfunction updateDisplay() {\ndisplay.value = current;\n}\nfunction appendDigit(d) {\nif (shouldReset) {\ncurrent = (d === '.') ? '0.' : d;\nshouldReset = false;\n} else {\nif (current === '0' && d !== '.') current = d;\nelse if (d === '.' && current.includes('.')) return;\nelse current += d;\n}\nupdateDisplay();\n}\nfunction appendOperator(op) {\nif (shouldReset) shouldReset = false;\nif (current === '0' && op === '-') {\ncurrent = '-';\n} else if (/[+\\-*/]$/.test(current)) {\ncurrent = current.slice(0, -1) + op;\n} else {\ncurrent += op;\n}\nupdateDisplay();\n}\nfunction clearDisplay() {\ncurrent = '0';\nshouldReset = false;\nupdateDisplay();\n}\nfunction calculate() {\ntry {\nlet expr = current.replace(/[^0-9+\\-*/.]/g, '');\nif (/[+\\-*/]$/.test(expr)) expr = expr.slice(0, -1);\nlet result = Function('\"use strict\"; return (' + expr + ')')();\nif (!isFinite(result)) throw new Error('Bad');\ncurrent = String(result);\nshouldReset = true;\nupdateDisplay();\n} catch (e) {\ncurrent = 'Error';\nshouldReset = true;\nupdateDisplay();\n}\n}\n</script>\n</body>\n</html>",
