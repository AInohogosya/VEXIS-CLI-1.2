    {
      "timestamp": "1784327298.1369832",
      "entry_type": "command",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Calculator</title>\n<style>\n* { box-sizing: border-box; margin: 0; padding: 0; }\nbody {\nmin-height: 100vh;\ndisplay: flex;\nalign-items: center;\njustify-content: center;\nbackground: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\nfont-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n}\n.calculator {\nbackground: rgba(255, 255, 255, 0.1);\nbackdrop-filter: blur(10px);\nborder-radius: 20px;\npadding: 20px;\nbox-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);\nwidth: 320px;\n}\n.display {\nbackground: rgba(0, 0, 0, 0.4);\ncolor: #fff;\nfont-size: 2rem;\ntext-align: right;\npadding: 15px;\nborder-radius: 10px;\nmargin-bottom: 15px;\nmin-height: 60px;\noverflow-x: auto;\nword-break: break-all;\n}\n.buttons {\ndisplay: grid;\ngrid-template-columns: repeat(4, 1fr);\ngap: 10px;\n}\nbutton {\nborder: none;\nborder-radius: 10px;\npadding: 18px;\nfont-size: 1.3rem;\ncursor: pointer;\nbackground: rgba(255, 255, 255, 0.2);\ncolor: #fff;\ntransition: background 0.2s, transform 0.1s;\n}\nbutton:hover { background: rgba(255, 255, 255, 0.35); }\nbutton:active { transform: scale(0.95); }\n.operator { background: rgba(255, 165, 0, 0.6); }\n.operator:hover { background: rgba(255, 165, 0, 0.8); }\n.clear { background: rgba(255, 80, 80, 0.6); }\n.clear:hover { background: rgba(255, 80, 80, 0.8); }\n.equals { background: rgba(60, 200, 120, 0.6); grid-column: span 2; }\n.equals:hover { background: rgba(60, 200, 120, 0.8); }\n.zero { grid-column: span 2; }\n</style>\n</head>\n<body>\n<div class=\"calculator\">\n<div class=\"display\" id=\"display\">0</div>\n<div class=\"buttons\">\n<button class=\"clear\" data-action=\"clear\">C</button>\n<button class=\"operator\" data-value=\"/\">/</button>\n<button class=\"operator\" data-value=\"*\">*</button>\n<button class=\"operator\" data-value=\"-\">-</button>\n<button data-value=\"7\">7</button>\n<button data-value=\"8\">8</button>\n<button data-value=\"9\">9</button>\n<button class=\"operator\" data-value=\"+\">+</button>\n<button data-value=\"4\">4</button>\n<button data-value=\"5\">5</button>\n<button data-value=\"6\">6</button>\n<button data-value=\"1\">1</button>\n<button data-value=\"2\">2</button>\n<button data-value=\"3\">3</button>\n<button data-value=\"0\" class=\"zero\">0</button>\n<button data-value=\".\">.</button>\n<button class=\"equals\" data-action=\"equals\">=</button>\n</div>\n</div>\n<script>\n(function() {\nvar display = document.getElementById('display');\nvar current = '0';\nvar justEvaluated = false;\nfunction updateDisplay() {\ndisplay.textContent = current;\n}\nfunction isOperator(ch) {\nreturn ch === '+' || ch === '-' || ch === '*' || ch === '/';\n}\nfunction handleInput(val) {\nif (justEvaluated) {\nif (isOperator(val)) {\njustEvaluated = false;\n} else {\ncurrent = '0';\njustEvaluated = false;\n}\n}\nif (val === '.') {\nvar parts = current.split(/[\\+\\-\\*\\/]/);\nvar last = parts[parts.length - 1];\nif (last.indexOf('.') !== -1) return;\nif (last === '') { current += '0.'; }\nelse { current += '.'; }\nupdateDisplay();\nreturn;\n}\nif (isOperator(val)) {\nif (current === '0') {\nif (val === '-') { current = '-'; updateDisplay(); }\nreturn;\n}\nvar lastChar = current[current.length - 1];\nif (isOperator(lastChar)) {\ncurrent = current.slice(0, -1) + val;\n} else {\ncurrent += val;\n}\nupdateDisplay();\nreturn;\n}\nif (current === '0') {\ncurrent = val;\n} else if (current === '-0') {\ncurrent = '-' + val;\n} else {\nvar segs = current.split(/[\\+\\-\\*\\/]/);\nvar lastSeg = segs[segs.length - 1];\nif (lastSeg === '0' && !lastSeg.includes('.')) {\nvar idx = current.lastIndexOf('0');\nif (idx === current.length - 1) {\ncurrent = current.slice(0, -1) + val;\n} else {\ncurrent += val;\n}\n} else {\ncurrent += val;\n}\n}\nupdateDisplay();\n}\nfunction clearAll() {\ncurrent = '0';\njustEvaluated = false;\nupdateDisplay();\n}\nfunction safeEvaluate(expr) {\nvar tokens = [];\nvar num = '';\nfor (var i = 0; i < expr.length; i++) {\nvar c = expr[i];\nif (isOperator(c)) {\nif (num === '') {\nif (c === '-' && (i === 0 || isOperator(expr[i-1]))) {\nnum = '-';\ncontinue;\n} else {\nreturn 'Error';\n}\n}\ntokens.push(parseFloat(num));\ntokens.push(c);\nnum = '';\n} else if (c >= '0' && c <= '9' || c === '.') {\nnum += c;\n} else {\nreturn 'Error';\n}\n}\nif (num === '' || num === '-') return 'Error';\ntokens.push(parseFloat(num));\nfor (var j = 0; j < tokens.length; j++) {\nif (tokens[j] === '*' || tokens[j] === '/') {\nvar left = tokens[j-1];\nvar right = tokens[j+1];\nif (tokens[j] === '/' && right === 0) return 'Error';\nvar res = tokens[j] === '*' ? left * right : left / right;\ntokens.splice(j-1, 3, res);\nj--;\n}\n}\nfor (var k = 0; k < tokens.length; k++) {\nif (tokens[k] === '+' || tokens[k] === '-') {\nvar l = tokens[k-1];\nvar r = tokens[k+1];\nvar r2 = tokens[k] === '+' ? l + r : l - r;\ntokens.splice(k-1, 3, r2);\nk--;\n}\n}\nreturn tokens[0];\n}\nfunction evaluate() {\nvar result = safeEvaluate(current);\nif (result === 'Error') {\ncurrent = 'Error';\n} else {\nif (!isFinite(result)) { current = 'Error'; }\nelse {\ncurrent = String(Math.round(result * 1e10) / 1e10);\n}\n}\njustEvaluated = true;\nupdateDisplay();\n}\ndocument.querySelectorAll('button').forEach(function(btn) {\nbtn.addEventListener('click', function() {\nvar action = btn.getAttribute('data-action');\nvar val = btn.getAttribute('data-value');\nif (action === 'clear') clearAll();\nelse if (action === 'equals') evaluate();\nelse if (val) handleInput(val);\n});\n});\nupdateDisplay();\n})();\n</script>\n</body>\n</html>",
      "command": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Calculator</title>\n<style>\n* { box-sizing: border-box; margin: 0; padding: 0; }\nbody {\nmin-height: 100vh;\ndisplay: flex;\nalign-items: center;\njustify-content: center;\nbackground: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\nfont-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n}\n.calculator {\nbackground: rgba(255, 255, 255, 0.1);\nbackdrop-filter: blur(10px);\nborder-radius: 20px;\npadding: 20px;\nbox-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);\nwidth: 320px;\n}\n.display {\nbackground: rgba(0, 0, 0, 0.4);\ncolor: #fff;\nfont-size: 2rem;\ntext-align: right;\npadding: 15px;\nborder-radius: 10px;\nmargin-bottom: 15px;\nmin-height: 60px;\noverflow-x: auto;\nword-break: break-all;\n}\n.buttons {\ndisplay: grid;\ngrid-template-columns: repeat(4, 1fr);\ngap: 10px;\n}\nbutton {\nborder: none;\nborder-radius: 10px;\npadding: 18px;\nfont-size: 1.3rem;\ncursor: pointer;\nbackground: rgba(255, 255, 255, 0.2);\ncolor: #fff;\ntransition: background 0.2s, transform 0.1s;\n}\nbutton:hover { background: rgba(255, 255, 255, 0.35); }\nbutton:active { transform: scale(0.95); }\n.operator { background: rgba(255, 165, 0, 0.6); }\n.operator:hover { background: rgba(255, 165, 0, 0.8); }\n.clear { background: rgba(255, 80, 80, 0.6); }\n.clear:hover { background: rgba(255, 80, 80, 0.8); }\n.equals { background: rgba(60, 200, 120, 0.6); grid-column: span 2; }\n.equals:hover { background: rgba(60, 200, 120, 0.8); }\n.zero { grid-column: span 2; }\n</style>\n</head>\n<body>\n<div class=\"calculator\">\n<div class=\"display\" id=\"display\">0</div>\n<div class=\"buttons\">\n<button class=\"clear\" data-action=\"clear\">C</button>\n<button class=\"operator\" data-value=\"/\">/</button>\n<button class=\"operator\" data-value=\"*\">*</button>\n<button class=\"operator\" data-value=\"-\">-</button>\n<button data-value=\"7\">7</button>\n<button data-value=\"8\">8</button>\n<button data-value=\"9\">9</button>\n<button class=\"operator\" data-value=\"+\">+</button>\n<button data-value=\"4\">4</button>\n<button data-value=\"5\">5</button>\n<button data-value=\"6\">6</button>\n<button data-value=\"1\">1</button>\n<button data-value=\"2\">2</button>\n<button data-value=\"3\">3</button>\n<button data-value=\"0\" class=\"zero\">0</button>\n<button data-value=\".\">.</button>\n<button class=\"equals\" data-action=\"equals\">=</button>\n</div>\n</div>\n<script>\n(function() {\nvar display = document.getElementById('display');\nvar current = '0';\nvar justEvaluated = false;\nfunction updateDisplay() {\ndisplay.textContent = current;\n}\nfunction isOperator(ch) {\nreturn ch === '+' || ch === '-' || ch === '*' || ch === '/';\n}\nfunction handleInput(val) {\nif (justEvaluated) {\nif (isOperator(val)) {\njustEvaluated = false;\n} else {\ncurrent = '0';\njustEvaluated = false;\n}\n}\nif (val === '.') {\nvar parts = current.split(/[\\+\\-\\*\\/]/);\nvar last = parts[parts.length - 1];\nif (last.indexOf('.') !== -1) return;\nif (last === '') { current += '0.'; }\nelse { current += '.'; }\nupdateDisplay();\nreturn;\n}\nif (isOperator(val)) {\nif (current === '0') {\nif (val === '-') { current = '-'; updateDisplay(); }\nreturn;\n}\nvar lastChar = current[current.length - 1];\nif (isOperator(lastChar)) {\ncurrent = current.slice(0, -1) + val;\n} else {\ncurrent += val;\n}\nupdateDisplay();\nreturn;\n}\nif (current === '0') {\ncurrent = val;\n} else if (current === '-0') {\ncurrent = '-' + val;\n} else {\nvar segs = current.split(/[\\+\\-\\*\\/]/);\nvar lastSeg = segs[segs.length - 1];\nif (lastSeg === '0' && !lastSeg.includes('.')) {\nvar idx = current.lastIndexOf('0');\nif (idx === current.length - 1) {\ncurrent = current.slice(0, -1) + val;\n} else {\ncurrent += val;\n}\n} else {\ncurrent += val;\n}\n}\nupdateDisplay();\n}\nfunction clearAll() {\ncurrent = '0';\njustEvaluated = false;\nupdateDisplay();\n}\nfunction safeEvaluate(expr) {\nvar tokens = [];\nvar num = '';\nfor (var i = 0; i < expr.length; i++) {\nvar c = expr[i];\nif (isOperator(c)) {\nif (num === '') {\nif (c === '-' && (i === 0 || isOperator(expr[i-1]))) {\nnum = '-';\ncontinue;\n} else {\nreturn 'Error';\n}\n}\ntokens.push(parseFloat(num));\ntokens.push(c);\nnum = '';\n} else if (c >= '0' && c <= '9' || c === '.') {\nnum += c;\n} else {\nreturn 'Error';\n}\n}\nif (num === '' || num === '-') return 'Error';\ntokens.push(parseFloat(num));\nfor (var j = 0; j < tokens.length; j++) {\nif (tokens[j] === '*' || tokens[j] === '/') {\nvar left = tokens[j-1];\nvar right = tokens[j+1];\nif (tokens[j] === '/' && right === 0) return 'Error';\nvar res = tokens[j] === '*' ? left * right : left / right;\ntokens.splice(j-1, 3, res);\nj--;\n}\n}\nfor (var k = 0; k < tokens.length; k++) {\nif (tokens[k] === '+' || tokens[k] === '-') {\nvar l = tokens[k-1];\nvar r = tokens[k+1];\nvar r2 = tokens[k] === '+' ? l + r : l - r;\ntokens.splice(k-1, 3, r2);\nk--;\n}\n}\nreturn tokens[0];\n}\nfunction evaluate() {\nvar result = safeEvaluate(current);\nif (result === 'Error') {\ncurrent = 'Error';\n} else {\nif (!isFinite(result)) { current = 'Error'; }\nelse {\ncurrent = String(Math.round(result * 1e10) / 1e10);\n}\n}\njustEvaluated = true;\nupdateDisplay();\n}\ndocument.querySelectorAll('button').forEach(function(btn) {\nbtn.addEventListener('click', function() {\nvar action = btn.getAttribute('data-action');\nvar val = btn.getAttribute('data-value');\nif (action === 'clear') clearAll();\nelse if (action === 'equals') evaluate();\nelse if (val) handleInput(val);\n});\n});\nupdateDisplay();\n})();\n</script>\n</body>\n</html>",
