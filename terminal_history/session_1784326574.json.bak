    {
      "timestamp": "1784326821.872673",
      "entry_type": "command",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Calculator</title>\n<style>\nbody {\nmargin: 0;\nmin-height: 100vh;\ndisplay: flex;\nalign-items: center;\njustify-content: center;\nbackground: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\nfont-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n}\n.calculator {\nbackground: rgba(255, 255, 255, 0.1);\nbackdrop-filter: blur(10px);\nborder-radius: 20px;\npadding: 20px;\nbox-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);\nwidth: 300px;\n}\n.display {\nwidth: 100%;\nheight: 60px;\nborder: none;\nborder-radius: 10px;\nbackground: rgba(0, 0, 0, 0.2);\ncolor: #fff;\nfont-size: 28px;\ntext-align: right;\npadding: 10px;\nbox-sizing: border-box;\nmargin-bottom: 15px;\noverflow: hidden;\n}\n.buttons {\ndisplay: grid;\ngrid-template-columns: repeat(4, 1fr);\ngap: 10px;\n}\nbutton {\nheight: 50px;\nborder: none;\nborder-radius: 10px;\nfont-size: 20px;\nfont-weight: bold;\ncursor: pointer;\nbackground: linear-gradient(145deg, #ffffff, #e6e6e6);\ncolor: #333;\ntransition: transform 0.1s, box-shadow 0.1s;\n}\nbutton:active {\ntransform: scale(0.95);\nbox-shadow: 0 2px 6px rgba(0,0,0,0.3);\n}\nbutton.operator {\nbackground: linear-gradient(145deg, #ff9a9e, #fecfef);\ncolor: #fff;\n}\nbutton.clear {\nbackground: linear-gradient(145deg, #ff6a88, #ff99ac);\ncolor: #fff;\n}\nbutton.equals {\nbackground: linear-gradient(145deg, #42e695, #3bb2b8);\ncolor: #fff;\ngrid-column: span 2;\n}\nbutton.zero {\ngrid-column: span 2;\n}\n</style>\n</head>\n<body>\n<div class=\"calculator\">\n<input type=\"text\" class=\"display\" id=\"display\" readonly value=\"\">\n<div class=\"buttons\">\n<button class=\"clear\" data-value=\"C\">C</button>\n<button class=\"operator\" data-value=\"/\">/</button>\n<button class=\"operator\" data-value=\"*\">*</button>\n<button class=\"operator\" data-value=\"-\">-</button>\n<button data-value=\"7\">7</button>\n<button data-value=\"8\">8</button>\n<button data-value=\"9\">9</button>\n<button class=\"operator\" data-value=\"+\">+</button>\n<button data-value=\"4\">4</button>\n<button data-value=\"5\">5</button>\n<button data-value=\"6\">6</button>\n<button data-value=\"1\">1</button>\n<button data-value=\"2\">2</button>\n<button data-value=\"3\">3</button>\n<button data-value=\"0\" class=\"zero\">0</button>\n<button data-value=\".\">.</button>\n<button class=\"equals\" data-value=\"=\">=</button>\n</div>\n</div>\n<script>\n(function() {\nvar display = document.getElementById('display');\nvar expr = '';\nfunction isOperator(ch) {\nreturn ch === '+' || ch === '-' || ch === '*' || ch === '/';\n}\nfunction handleInput(val) {\nif (val === 'C') {\nexpr = '';\ndisplay.value = '';\nreturn;\n}\nif (val === '=') {\nvar result = safeEvaluate(expr);\ndisplay.value = result;\nexpr = (result === 'Error') ? '' : String(result);\nreturn;\n}\nif (val === '.') {\nvar lastNum = expr.split(/[\\+\\-\\*\\/]/).pop();\nif (lastNum.indexOf('.') !== -1) return;\nif (lastNum === '') { expr += '0.'; }\nelse { expr += '.'; }\ndisplay.value = expr;\nreturn;\n}\nif (isOperator(val)) {\nif (expr === '') {\nif (val === '-') { expr = '-'; display.value = expr; }\nreturn;\n}\nvar lastCh = expr.charAt(expr.length - 1);\nif (isOperator(lastCh)) {\nexpr = expr.slice(0, -1) + val;\n} else {\nexpr += val;\n}\ndisplay.value = expr;\nreturn;\n}\nif (val >= '0' && val <= '9') {\nvar lastChar = expr.charAt(expr.length - 1);\nvar currentNum = expr.split(/[\\+\\-\\*\\/]/).pop();\nif (currentNum === '0' && val === '0') return;\nif (currentNum === '0' && val !== '0' && lastChar === '0') {\nexpr = expr.slice(0, -1) + val;\n} else {\nexpr += val;\n}\ndisplay.value = expr;\nreturn;\n}\n}\nfunction safeEvaluate(expression) {\nif (expression === '' || expression === '-') return '';\nvar tokens = [];\nvar numStr = '';\nfor (var i = 0; i < expression.length; i++) {\nvar c = expression.charAt(i);\nif (c >= '0' && c <= '9' || c === '.') {\nnumStr += c;\n} else if (isOperator(c)) {\nif (numStr === '') {\nif (c === '-' && (i === 0 || isOperator(expression.charAt(i-1)))) {\nnumStr = '-';\ncontinue;\n} else {\nreturn 'Error';\n}\n}\ntokens.push(parseFloat(numStr));\ntokens.push(c);\nnumStr = '';\n} else {\nreturn 'Error';\n}\n}\nif (numStr === '' || numStr === '-') return 'Error';\ntokens.push(parseFloat(numStr));\nfor (var j = 1; j < tokens.length; j += 2) {\nif (tokens[j] === '*' || tokens[j] === '/') {\nvar left = tokens[j-1];\nvar right = tokens[j+1];\nif (tokens[j] === '/' && right === 0) return 'Error';\nvar res = tokens[j] === '*' ? left * right : left / right;\ntokens.splice(j-1, 3, res);\nj -= 2;\n}\n}\nfor (var k = 1; k < tokens.length; k += 2) {\nif (tokens[k] === '+' || tokens[k] === '-') {\nvar l = tokens[k-1];\nvar r = tokens[k+1];\nvar r2 = tokens[k] === '+' ? l + r : l - r;\ntokens.splice(k-1, 3, r2);\nk -= 2;\n}\n}\nvar final = tokens[0];\nif (!isFinite(final)) return 'Error';\nreturn String(final);\n}\nvar buttons = document.querySelectorAll('button');\nbuttons.forEach(function(btn) {\nbtn.addEventListener('click', function() {\nhandleInput(btn.getAttribute('data-value'));\n});\n});\n})();\n</script>\n</body>\n</html>",
      "command": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Calculator</title>\n<style>\nbody {\nmargin: 0;\nmin-height: 100vh;\ndisplay: flex;\nalign-items: center;\njustify-content: center;\nbackground: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\nfont-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n}\n.calculator {\nbackground: rgba(255, 255, 255, 0.1);\nbackdrop-filter: blur(10px);\nborder-radius: 20px;\npadding: 20px;\nbox-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);\nwidth: 300px;\n}\n.display {\nwidth: 100%;\nheight: 60px;\nborder: none;\nborder-radius: 10px;\nbackground: rgba(0, 0, 0, 0.2);\ncolor: #fff;\nfont-size: 28px;\ntext-align: right;\npadding: 10px;\nbox-sizing: border-box;\nmargin-bottom: 15px;\noverflow: hidden;\n}\n.buttons {\ndisplay: grid;\ngrid-template-columns: repeat(4, 1fr);\ngap: 10px;\n}\nbutton {\nheight: 50px;\nborder: none;\nborder-radius: 10px;\nfont-size: 20px;\nfont-weight: bold;\ncursor: pointer;\nbackground: linear-gradient(145deg, #ffffff, #e6e6e6);\ncolor: #333;\ntransition: transform 0.1s, box-shadow 0.1s;\n}\nbutton:active {\ntransform: scale(0.95);\nbox-shadow: 0 2px 6px rgba(0,0,0,0.3);\n}\nbutton.operator {\nbackground: linear-gradient(145deg, #ff9a9e, #fecfef);\ncolor: #fff;\n}\nbutton.clear {\nbackground: linear-gradient(145deg, #ff6a88, #ff99ac);\ncolor: #fff;\n}\nbutton.equals {\nbackground: linear-gradient(145deg, #42e695, #3bb2b8);\ncolor: #fff;\ngrid-column: span 2;\n}\nbutton.zero {\ngrid-column: span 2;\n}\n</style>\n</head>\n<body>\n<div class=\"calculator\">\n<input type=\"text\" class=\"display\" id=\"display\" readonly value=\"\">\n<div class=\"buttons\">\n<button class=\"clear\" data-value=\"C\">C</button>\n<button class=\"operator\" data-value=\"/\">/</button>\n<button class=\"operator\" data-value=\"*\">*</button>\n<button class=\"operator\" data-value=\"-\">-</button>\n<button data-value=\"7\">7</button>\n<button data-value=\"8\">8</button>\n<button data-value=\"9\">9</button>\n<button class=\"operator\" data-value=\"+\">+</button>\n<button data-value=\"4\">4</button>\n<button data-value=\"5\">5</button>\n<button data-value=\"6\">6</button>\n<button data-value=\"1\">1</button>\n<button data-value=\"2\">2</button>\n<button data-value=\"3\">3</button>\n<button data-value=\"0\" class=\"zero\">0</button>\n<button data-value=\".\">.</button>\n<button class=\"equals\" data-value=\"=\">=</button>\n</div>\n</div>\n<script>\n(function() {\nvar display = document.getElementById('display');\nvar expr = '';\nfunction isOperator(ch) {\nreturn ch === '+' || ch === '-' || ch === '*' || ch === '/';\n}\nfunction handleInput(val) {\nif (val === 'C') {\nexpr = '';\ndisplay.value = '';\nreturn;\n}\nif (val === '=') {\nvar result = safeEvaluate(expr);\ndisplay.value = result;\nexpr = (result === 'Error') ? '' : String(result);\nreturn;\n}\nif (val === '.') {\nvar lastNum = expr.split(/[\\+\\-\\*\\/]/).pop();\nif (lastNum.indexOf('.') !== -1) return;\nif (lastNum === '') { expr += '0.'; }\nelse { expr += '.'; }\ndisplay.value = expr;\nreturn;\n}\nif (isOperator(val)) {\nif (expr === '') {\nif (val === '-') { expr = '-'; display.value = expr; }\nreturn;\n}\nvar lastCh = expr.charAt(expr.length - 1);\nif (isOperator(lastCh)) {\nexpr = expr.slice(0, -1) + val;\n} else {\nexpr += val;\n}\ndisplay.value = expr;\nreturn;\n}\nif (val >= '0' && val <= '9') {\nvar lastChar = expr.charAt(expr.length - 1);\nvar currentNum = expr.split(/[\\+\\-\\*\\/]/).pop();\nif (currentNum === '0' && val === '0') return;\nif (currentNum === '0' && val !== '0' && lastChar === '0') {\nexpr = expr.slice(0, -1) + val;\n} else {\nexpr += val;\n}\ndisplay.value = expr;\nreturn;\n}\n}\nfunction safeEvaluate(expression) {\nif (expression === '' || expression === '-') return '';\nvar tokens = [];\nvar numStr = '';\nfor (var i = 0; i < expression.length; i++) {\nvar c = expression.charAt(i);\nif (c >= '0' && c <= '9' || c === '.') {\nnumStr += c;\n} else if (isOperator(c)) {\nif (numStr === '') {\nif (c === '-' && (i === 0 || isOperator(expression.charAt(i-1)))) {\nnumStr = '-';\ncontinue;\n} else {\nreturn 'Error';\n}\n}\ntokens.push(parseFloat(numStr));\ntokens.push(c);\nnumStr = '';\n} else {\nreturn 'Error';\n}\n}\nif (numStr === '' || numStr === '-') return 'Error';\ntokens.push(parseFloat(numStr));\nfor (var j = 1; j < tokens.length; j += 2) {\nif (tokens[j] === '*' || tokens[j] === '/') {\nvar left = tokens[j-1];\nvar right = tokens[j+1];\nif (tokens[j] === '/' && right === 0) return 'Error';\nvar res = tokens[j] === '*' ? left * right : left / right;\ntokens.splice(j-1, 3, res);\nj -= 2;\n}\n}\nfor (var k = 1; k < tokens.length; k += 2) {\nif (tokens[k] === '+' || tokens[k] === '-') {\nvar l = tokens[k-1];\nvar r = tokens[k+1];\nvar r2 = tokens[k] === '+' ? l + r : l - r;\ntokens.splice(k-1, 3, r2);\nk -= 2;\n}\n}\nvar final = tokens[0];\nif (!isFinite(final)) return 'Error';\nreturn String(final);\n}\nvar buttons = document.querySelectorAll('button');\nbuttons.forEach(function(btn) {\nbtn.addEventListener('click', function() {\nhandleInput(btn.getAttribute('data-value'));\n});\n});\n})();\n</script>\n</body>\n</html>",
