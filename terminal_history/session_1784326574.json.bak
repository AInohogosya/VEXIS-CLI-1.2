      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Calculator</title>\n<style>\nbody {\nmargin: 0;\nmin-height: 100vh;\ndisplay: flex;\nalign-items: center;\njustify-content: center;\nbackground: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\nfont-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n}\n.calculator {\nbackground: rgba(255, 255, 255, 0.1);\nbackdrop-filter: blur(10px);\nborder-radius: 20px;\npadding: 20px;\nbox-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);\nwidth: 280px;\n}\n.display {\nbackground: rgba(0, 0, 0, 0.4);\ncolor: #fff;\nfont-size: 2rem;\ntext-align: right;\npadding: 15px;\nborder-radius: 10px;\nmargin-bottom: 15px;\noverflow: hidden;\nmin-height: 2.5rem;\nword-break: break-all;\n}\n.buttons {\ndisplay: grid;\ngrid-template-columns: repeat(4, 1fr);\ngap: 10px;\n}\nbutton {\nborder: none;\nborder-radius: 10px;\npadding: 18px 0;\nfont-size: 1.2rem;\ncursor: pointer;\nbackground: rgba(255, 255, 255, 0.2);\ncolor: #fff;\ntransition: background 0.2s, transform 0.1s;\n}\nbutton:hover {\nbackground: rgba(255, 255, 255, 0.35);\n}\nbutton:active {\ntransform: scale(0.95);\n}\n.operator {\nbackground: rgba(255, 159, 67, 0.8);\n}\n.operator:hover {\nbackground: rgba(255, 159, 67, 1);\n}\n.clear {\nbackground: rgba(255, 99, 132, 0.8);\n}\n.clear:hover {\nbackground: rgba(255, 99, 132, 1);\n}\n.equals {\nbackground: rgba(75, 207, 250, 0.8);\ngrid-column: span 2;\n}\n.equals:hover {\nbackground: rgba(75, 207, 250, 1);\n}\n.zero {\ngrid-column: span 2;\n}\n</style>\n</head>\n<body>\n<div class=\"calculator\">\n<div class=\"display\" id=\"display\">0</div>\n<div class=\"buttons\">\n<button class=\"clear\" data-action=\"clear\">C</button>\n<button class=\"operator\" data-value=\"/\">/</button>\n<button class=\"operator\" data-value=\"*\">*</button>\n<button class=\"operator\" data-value=\"-\">-</button>\n<button data-value=\"7\">7</button>\n<button data-value=\"8\">8</button>\n<button data-value=\"9\">9</button>\n<button class=\"operator\" data-value=\"+\">+</button>\n<button data-value=\"4\">4</button>\n<button data-value=\"5\">5</button>\n<button data-value=\"6\">6</button>\n<button data-value=\"1\">1</button>\n<button data-value=\"2\">2</button>\n<button data-value=\"3\">3</button>\n<button data-value=\"0\" class=\"zero\">0</button>\n<button data-value=\".\">.</button>\n<button class=\"equals\" data-action=\"equals\">=</button>\n</div>\n</div>\n<script>\n(function() {\nvar display = document.getElementById('display');\nvar current = '0';\nvar justEvaluated = false;\nfunction updateDisplay() {\ndisplay.textContent = current;\n}\nfunction isOperator(ch) {\nreturn ch === '+' || ch === '-' || ch === '*' || ch === '/';\n}\nfunction inputValue(val) {\nif (justEvaluated) {\nif (isOperator(val)) {\njustEvaluated = false;\n} else {\ncurrent = '0';\njustEvaluated = false;\n}\n}\nif (val === '.') {\nvar parts = current.split(/[\\+\\-\\*\\/]/);\nvar last = parts[parts.length - 1];\nif (last.indexOf('.') !== -1) return;\nif (last === '') {\ncurrent += '0.';\n} else {\ncurrent += '.';\n}\nupdateDisplay();\nreturn;\n}\nif (isOperator(val)) {\nif (current === '0' && val !== '-') return;\nvar lastChar = current[current.length - 1];\nif (isOperator(lastChar)) {\ncurrent = current.slice(0, -1) + val;\n} else {\ncurrent += val;\n}\nupdateDisplay();\nreturn;\n}\nif (current === '0') {\ncurrent = val;\n} else {\nvar lastPart = current.split(/[\\+\\-\\*\\/]/).pop();\nif (lastPart === '0' && val !== '.') {\nvar idx = current.length - 1;\nwhile (idx >= 0 && current[idx] !== '+' && current[idx] !== '-' && current[idx] !== '*' && current[idx] !== '/') {\nidx--;\n}\ncurrent = current.slice(0, idx + 1) + val;\n} else {\ncurrent += val;\n}\n}\nupdateDisplay();\n}\nfunction clearAll() {\ncurrent = '0';\njustEvaluated = false;\nupdateDisplay();\n}\nfunction safeEvaluate(expr) {\nvar tokens = [];\nvar num = '';\nfor (var i = 0; i < expr.length; i++) {\nvar ch = expr[i];\nif (isOperator(ch)) {\nif (num === '') {\nif (ch === '-' && (i === 0 || isOperator(expr[i-1]))) {\nnum = '-';\ncontinue;\n} else {\nreturn 'Error';\n}\n}\ntokens.push(parseFloat(num));\ntokens.push(ch);\nnum = '';\n} else {\nnum += ch;\n}\n}\nif (num === '' || num === '-') return 'Error';\ntokens.push(parseFloat(num));\nfor (var j = 0; j < tokens.length; j++) {\nif (tokens[j] === '*' || tokens[j] === '/') {\nvar left = tokens[j-1];\nvar right = tokens[j+1];\nif (tokens[j] === '/' && right === 0) return 'Error';\nvar res = tokens[j] === '*' ? left * right : left / right;\ntokens.splice(j-1, 3, res);\nj--;\n}\n}\nfor (var k = 0; k < tokens.length; k++) {\nif (tokens[k] === '+' || tokens[k] === '-') {\nvar l = tokens[k-1];\nvar r = tokens[k+1];\nvar r2 = tokens[k] === '+' ? l + r : l - r;\ntokens.splice(k-1, 3, r2);\nk--;\n}\n}\nreturn tokens[0];\n}\nfunction evaluate() {\nvar result = safeEvaluate(current);\nif (result === 'Error') {\ncurrent = 'Error';\n} else {\nif (!isFinite(result)) {\ncurrent = 'Error';\n} else {\ncurrent = String(result);\n}\n}\njustEvaluated = true;\nupdateDisplay();\n}\ndocument.querySelectorAll('button').forEach(function(btn) {\nbtn.addEventListener('click', function() {\nvar action = btn.getAttribute('data-action');\nvar value = btn.getAttribute('data-value');\nif (action === 'clear') {\nclearAll();\n} else if (action === 'equals') {\nevaluate();\n} else if (value) {\ninputValue(value);\n}\n});\n});\nupdateDisplay();\n})();\n</script>\n</body>\n</html>",
      "command": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Calculator</title>\n<style>\nbody {\nmargin: 0;\nmin-height: 100vh;\ndisplay: flex;\nalign-items: center;\njustify-content: center;\nbackground: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\nfont-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n}\n.calculator {\nbackground: rgba(255, 255, 255, 0.1);\nbackdrop-filter: blur(10px);\nborder-radius: 20px;\npadding: 20px;\nbox-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);\nwidth: 280px;\n}\n.display {\nbackground: rgba(0, 0, 0, 0.4);\ncolor: #fff;\nfont-size: 2rem;\ntext-align: right;\npadding: 15px;\nborder-radius: 10px;\nmargin-bottom: 15px;\noverflow: hidden;\nmin-height: 2.5rem;\nword-break: break-all;\n}\n.buttons {\ndisplay: grid;\ngrid-template-columns: repeat(4, 1fr);\ngap: 10px;\n}\nbutton {\nborder: none;\nborder-radius: 10px;\npadding: 18px 0;\nfont-size: 1.2rem;\ncursor: pointer;\nbackground: rgba(255, 255, 255, 0.2);\ncolor: #fff;\ntransition: background 0.2s, transform 0.1s;\n}\nbutton:hover {\nbackground: rgba(255, 255, 255, 0.35);\n}\nbutton:active {\ntransform: scale(0.95);\n}\n.operator {\nbackground: rgba(255, 159, 67, 0.8);\n}\n.operator:hover {\nbackground: rgba(255, 159, 67, 1);\n}\n.clear {\nbackground: rgba(255, 99, 132, 0.8);\n}\n.clear:hover {\nbackground: rgba(255, 99, 132, 1);\n}\n.equals {\nbackground: rgba(75, 207, 250, 0.8);\ngrid-column: span 2;\n}\n.equals:hover {\nbackground: rgba(75, 207, 250, 1);\n}\n.zero {\ngrid-column: span 2;\n}\n</style>\n</head>\n<body>\n<div class=\"calculator\">\n<div class=\"display\" id=\"display\">0</div>\n<div class=\"buttons\">\n<button class=\"clear\" data-action=\"clear\">C</button>\n<button class=\"operator\" data-value=\"/\">/</button>\n<button class=\"operator\" data-value=\"*\">*</button>\n<button class=\"operator\" data-value=\"-\">-</button>\n<button data-value=\"7\">7</button>\n<button data-value=\"8\">8</button>\n<button data-value=\"9\">9</button>\n<button class=\"operator\" data-value=\"+\">+</button>\n<button data-value=\"4\">4</button>\n<button data-value=\"5\">5</button>\n<button data-value=\"6\">6</button>\n<button data-value=\"1\">1</button>\n<button data-value=\"2\">2</button>\n<button data-value=\"3\">3</button>\n<button data-value=\"0\" class=\"zero\">0</button>\n<button data-value=\".\">.</button>\n<button class=\"equals\" data-action=\"equals\">=</button>\n</div>\n</div>\n<script>\n(function() {\nvar display = document.getElementById('display');\nvar current = '0';\nvar justEvaluated = false;\nfunction updateDisplay() {\ndisplay.textContent = current;\n}\nfunction isOperator(ch) {\nreturn ch === '+' || ch === '-' || ch === '*' || ch === '/';\n}\nfunction inputValue(val) {\nif (justEvaluated) {\nif (isOperator(val)) {\njustEvaluated = false;\n} else {\ncurrent = '0';\njustEvaluated = false;\n}\n}\nif (val === '.') {\nvar parts = current.split(/[\\+\\-\\*\\/]/);\nvar last = parts[parts.length - 1];\nif (last.indexOf('.') !== -1) return;\nif (last === '') {\ncurrent += '0.';\n} else {\ncurrent += '.';\n}\nupdateDisplay();\nreturn;\n}\nif (isOperator(val)) {\nif (current === '0' && val !== '-') return;\nvar lastChar = current[current.length - 1];\nif (isOperator(lastChar)) {\ncurrent = current.slice(0, -1) + val;\n} else {\ncurrent += val;\n}\nupdateDisplay();\nreturn;\n}\nif (current === '0') {\ncurrent = val;\n} else {\nvar lastPart = current.split(/[\\+\\-\\*\\/]/).pop();\nif (lastPart === '0' && val !== '.') {\nvar idx = current.length - 1;\nwhile (idx >= 0 && current[idx] !== '+' && current[idx] !== '-' && current[idx] !== '*' && current[idx] !== '/') {\nidx--;\n}\ncurrent = current.slice(0, idx + 1) + val;\n} else {\ncurrent += val;\n}\n}\nupdateDisplay();\n}\nfunction clearAll() {\ncurrent = '0';\njustEvaluated = false;\nupdateDisplay();\n}\nfunction safeEvaluate(expr) {\nvar tokens = [];\nvar num = '';\nfor (var i = 0; i < expr.length; i++) {\nvar ch = expr[i];\nif (isOperator(ch)) {\nif (num === '') {\nif (ch === '-' && (i === 0 || isOperator(expr[i-1]))) {\nnum = '-';\ncontinue;\n} else {\nreturn 'Error';\n}\n}\ntokens.push(parseFloat(num));\ntokens.push(ch);\nnum = '';\n} else {\nnum += ch;\n}\n}\nif (num === '' || num === '-') return 'Error';\ntokens.push(parseFloat(num));\nfor (var j = 0; j < tokens.length; j++) {\nif (tokens[j] === '*' || tokens[j] === '/') {\nvar left = tokens[j-1];\nvar right = tokens[j+1];\nif (tokens[j] === '/' && right === 0) return 'Error';\nvar res = tokens[j] === '*' ? left * right : left / right;\ntokens.splice(j-1, 3, res);\nj--;\n}\n}\nfor (var k = 0; k < tokens.length; k++) {\nif (tokens[k] === '+' || tokens[k] === '-') {\nvar l = tokens[k-1];\nvar r = tokens[k+1];\nvar r2 = tokens[k] === '+' ? l + r : l - r;\ntokens.splice(k-1, 3, r2);\nk--;\n}\n}\nreturn tokens[0];\n}\nfunction evaluate() {\nvar result = safeEvaluate(current);\nif (result === 'Error') {\ncurrent = 'Error';\n} else {\nif (!isFinite(result)) {\ncurrent = 'Error';\n} else {\ncurrent = String(result);\n}\n}\njustEvaluated = true;\nupdateDisplay();\n}\ndocument.querySelectorAll('button').forEach(function(btn) {\nbtn.addEventListener('click', function() {\nvar action = btn.getAttribute('data-action');\nvar value = btn.getAttribute('data-value');\nif (action === 'clear') {\nclearAll();\n} else if (action === 'equals') {\nevaluate();\n} else if (value) {\ninputValue(value);\n}\n});\n});\nupdateDisplay();\n})();\n</script>\n</body>\n</html>",
