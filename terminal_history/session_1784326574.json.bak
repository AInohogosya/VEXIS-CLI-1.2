um=\"7\">7</button>\n<button data-num=\"8\">8</button>\n<button data-num=\"9\">9</button>\n<button class=\"operator\" data-op=\"-\">-</button>\n<button data-num=\"4\">4</button>\n<button data-num=\"5\">5</button>\n<button data-num=\"6\">6</button>\n<button class=\"operator\" data-op=\"+\">+</button>\n<button data-num=\"1\">1</button>\n<button data-num=\"2\">2</button>\n<button data-num=\"3\">3</button>\n<button data-num=\"0\">0</button>\n<button data-num=\".\">.</button>\n<button class=\"equals\" data-action=\"equals\">=</button>\n</div>\n</div>\n<script>\n(function() {\nvar display = document.getElementById('display');\nvar expr = '';\nfunction updateDisplay() {\ndisplay.value = expr === '' ? '0' : expr;\n}\nfunction appendNum(n) {\nif (expr === '0' && n !== '.') { expr = ''; }\nif (n === '.') {\nvar parts = expr.split(/[\\+\\-\\*\\/]/);\nvar last = parts[parts.length - 1];\nif (last.indexOf('.') !== -1) return;\nif (last === '') { expr += '0.'; updateDisplay(); return; }\n}\nif (/[0-9]/.test(n) && /(^|[\\+\\-\\*\\/])0$/.test(expr)) {\nexpr = expr.slice(0, -1) + n;\n} else {\nexpr += n;\n}\nupdateDisplay();\n}\nfunction appendOp(op) {\nif (expr === '') {\nif (op === '-') { expr = '-'; }\nupdateDisplay(); return;\n}\nif (/[\\+\\-\\*\\/]$/.test(expr)) {\nexpr = expr.slice(0, -1) + op;\n} else {\nexpr += op;\n}\nupdateDisplay();\n}\nfunction clearAll() {\nexpr = '';\nupdateDisplay();\n}\nfunction safeEvaluate(input) {\nvar tokens = input.match(/(\\d+\\.?\\d*|[\\+\\-\\*\\/])/g);\nif (!tokens) return null;\nvar output = [];\nvar ops = [];\nvar prec = { '+': 1, '-': 1, '*': 2, '/': 2 };\nfunction applyOp() {\nvar b = output.pop();\nvar a = output.pop();\nvar op = ops.pop();\nif (op === '/' && b === 0) return 'Error';\nif (op === '+') output.push(a + b);\nelse if (op === '-') output.push(a - b);\nelse if (op === '*') output.push(a * b);\nelse if (op === '/') output.push(a / b);\n}\nfor (var i = 0; i < tokens.length; i++) {\nvar t = tokens[i];\nif (/\\d/.test(t)) {\noutput.push(parseFloat(t));\n} else {\nwhile (ops.length && prec[ops[ops.length - 1]] >= prec[t]) {\nif (applyOp() === 'Error') return 'Error';\n}\nops.push(t);\n}\n}\nwhile (ops.length) {\nif (applyOp() === 'Error') return 'Error';\n}\nvar res = output[0];\nif (!isFinite(res)) return 'Error';\nreturn String(res);\n}\nfunction calculate() {\nvar result = safeEvaluate(expr);\nif (result === null) { expr = 'Error'; }\nelse { expr = result; }\nupdateDisplay();\nif (expr === 'Error') expr = '';\n}\ndocument.querySelectorAll('button[data-num]').forEach(function(b) {\nb.addEventListener('click', function() { appendNum(b.getAttribute('data-num')); });\n});\ndocument.querySelectorAll('button[data-op]').forEach(function(b) {\nb.addEventListener('click', function() { appendOp(b.getAttribute('data-op')); });\n});\ndocument.querySelector('button[data-action=\"clear\"]').addEventListener('click', clearAll);\ndocument.querySelector('button[data-action=\"equals\"]').addEventListener('click', calculate);\nupdateDisplay();\n})();\n</script>\n</body>\n</html>",
