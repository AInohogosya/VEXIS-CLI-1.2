ut);\nif (res === 'Error') {\ndisplay.textContent = 'Error';\ncurrentInput = '';\n} else {\nlet out = String(res);\nif (out.endsWith('.0')) out = out.slice(0, -2);\ncurrentInput = out;\ndisplay.textContent = out;\n}\nreturn;\n}\nif ('+-*/'.includes(value)) {\nif (currentInput === '') return;\nconst last = currentInput[currentInput.length - 1];\nif ('+-*/'.includes(last)) {\ncurrentInput = currentInput.slice(0, -1) + value;\n} else {\ncurrentInput += value;\n}\nupdateDisplay();\nreturn;\n}\nif (value === '.') {\nconst parts = currentInput.split(/[+\\-*/]/);\nconst lastPart = parts[parts.length - 1];\nif (lastPart.includes('.')) return;\nif (currentInput === '' || '+-*/'.includes(currentInput[currentInput.length - 1])) {\ncurrentInput += '0.';\n} else {\ncurrentInput += '.';\n}\nupdateDisplay();\nreturn;\n}\nif ('0123456789'.includes(value)) {\nconst parts = currentInput.split(/[+\\-*/]/);\nconst lastPart = parts[parts.length - 1];\nif (lastPart === '0') {\ncurrentInput = currentInput.slice(0, -1) + value;\n} else {\ncurrentInput += value;\n}\nupdateDisplay();\nreturn;\n}\n}\ndocument.querySelectorAll('button').forEach(btn => {\nbtn.addEventListener('click', () => {\nhandleInput(btn.getAttribute('data-value'));\n});\n});\nupdateDisplay();\n})();\n</script>\n</body>\n</html>",
