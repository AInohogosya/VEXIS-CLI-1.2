nt);\nif (res === 'Error') {\ncurrent = 'Error';\n} else {\ncurrent = String(res);\n}\njustEvaluated = true;\nupdateDisplay();\nreturn;\n}\nif (justEvaluated) {\nif (isOperator(val)) {\njustEvaluated = false;\n} else if (val === '.') {\ncurrent = '0.';\njustEvaluated = false;\nupdateDisplay();\nreturn;\n} else {\ncurrent = '0';\njustEvaluated = false;\n}\n}\nif (isOperator(val)) {\nif (current === 'Error') return;\nvar last = current[current.length - 1];\nif (isOperator(last)) {\ncurrent = current.slice(0, -1) + val;\n} else {\ncurrent += val;\n}\nupdateDisplay();\nreturn;\n}\nif (val === '.') {\nif (current === 'Error') return;\nvar parts = current.split(/[\\+\\-\\*\\/]/);\nvar lastPart = parts[parts.length - 1];\nif (lastPart.indexOf('.') !== -1) return;\nif (isOperator(current[current.length - 1]) || current === '0') {\ncurrent += '0.';\n} else {\ncurrent += '.';\n}\nupdateDisplay();\nreturn;\n}\n// digit\nif (current === 'Error') return;\nif (current === '0') {\ncurrent = val;\n} else {\nvar lastChar = current[current.length - 1];\nvar seg = current.split(/[\\+\\-\\*\\/]/);\nvar curSeg = seg[seg.length - 1];\nif (isOperator(lastChar)) {\ncurrent += val;\n} else if (curSeg === '0') {\ncurrent = current.slice(0, -1) + val;\n} else {\ncurrent += val;\n}\n}\nupdateDisplay();\n}\nvar buttons = document.querySelectorAll('button');\nbuttons.forEach(function(btn) {\nbtn.addEventListener('click', function() {\nhandleInput(btn.getAttribute('data-value'));\n});\n});\nupdateDisplay();\n})();\n</script>\n</body>\n</html>",
