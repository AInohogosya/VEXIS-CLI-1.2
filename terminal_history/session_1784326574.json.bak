    {
      "timestamp": "1784326887.016608",
      "entry_type": "command",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Calculator</title>\n<style>\n* { box-sizing: border-box; margin: 0; padding: 0; }\nbody {\nmin-height: 100vh;\ndisplay: flex;\nalign-items: center;\njustify-content: center;\nbackground: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\nfont-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n}\n.calculator {\nbackground: rgba(255, 255, 255, 0.1);\nbackdrop-filter: blur(10px);\nborder-radius: 20px;\npadding: 20px;\nbox-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);\nwidth: 320px;\n}\n.display {\nwidth: 100%;\nheight: 60px;\nborder: none;\nborder-radius: 12px;\nbackground: rgba(0, 0, 0, 0.25);\ncolor: #fff;\nfont-size: 28px;\ntext-align: right;\npadding: 10px 15px;\nmargin-bottom: 15px;\noverflow: hidden;\n}\n.buttons {\ndisplay: grid;\ngrid-template-columns: repeat(4, 1fr);\ngap: 10px;\n}\nbutton {\nheight: 55px;\nborder: none;\nborder-radius: 12px;\nfont-size: 20px;\nfont-weight: 600;\ncursor: pointer;\nbackground: rgba(255, 255, 255, 0.85);\ncolor: #333;\ntransition: transform 0.1s, background 0.2s;\n}\nbutton:hover { background: #fff; transform: translateY(-2px); }\nbutton:active { transform: translateY(0); }\n.operator { background: linear-gradient(135deg, #f093fb, #f5576c); color: #fff; }\n.operator:hover { background: linear-gradient(135deg, #f5576c, #f093fb); }\n.clear { background: linear-gradient(135deg, #ffd86f, #fc6262); color: #fff; }\n.equals { background: linear-gradient(135deg, #43e97b, #38f9d7); color: #333; grid-column: span 2; }\n.zero { grid-column: span 2; }\n</style>\n</head>\n<body>\n<div class=\"calculator\">\n<input type=\"text\" class=\"display\" id=\"display\" value=\"0\" readonly>\n<div class=\"buttons\">\n<button class=\"clear\" data-value=\"C\">C</button>\n<button class=\"operator\" data-value=\"/\">/</button>\n<button class=\"operator\" data-value=\"*\">*</button>\n<button class=\"operator\" data-value=\"-\">-</button>\n<button data-value=\"7\">7</button>\n<button data-value=\"8\">8</button>\n<button data-value=\"9\">9</button>\n<button class=\"operator\" data-value=\"+\">+</button>\n<button data-value=\"4\">4</button>\n<button data-value=\"5\">5</button>\n<button data-value=\"6\">6</button>\n<button data-value=\"1\">1</button>\n<button data-value=\"2\">2</button>\n<button data-value=\"3\">3</button>\n<button data-value=\"0\" class=\"zero\">0</button>\n<button data-value=\".\">.</button>\n<button class=\"equals\" data-value=\"=\">=</button>\n</div>\n</div>\n<script>\n(function() {\nvar display = document.getElementById('display');\nvar expr = '';\nfunction isOperator(ch) {\nreturn ch === '+' || ch === '-' || ch === '*' || ch === '/';\n}\nfunction appendValue(v) {\nif (v === 'C') {\nexpr = '';\ndisplay.value = '0';\nreturn;\n}\nif (v === '=') {\nvar result = safeEvaluate(expr);\ndisplay.value = result;\nexpr = (result === 'Error') ? '' : String(result);\nreturn;\n}\nif (isOperator(v)) {\nif (expr === '' && v !== '-') return;\nif (expr !== '' && isOperator(expr[expr.length - 1])) {\nexpr = expr.slice(0, -1) + v;\ndisplay.value = expr;\nreturn;\n}\nexpr += v;\ndisplay.value = expr;\nreturn;\n}\nif (v === '.') {\nvar parts = expr.split(/[\\+\\-\\*\\/]/);\nvar last = parts[parts.length - 1];\nif (last === '' || last.indexOf('.') !== -1) return;\nif (expr === '' || isOperator(expr[expr.length - 1])) {\nexpr += '0.';\n} else {\nexpr += '.';\n}\ndisplay.value = expr;\nreturn;\n}\nif (expr === '' || expr === '0') {\nexpr = v;\ndisplay.value = expr;\nreturn;\n}\nvar seg = expr.split(/[\\+\\-\\*\\/]/);\nvar cur = seg[seg.length - 1];\nif (cur !== '0' || isOperator(expr[expr.length - 1])) {\nexpr += v;\n} else if (isOperator(expr[expr.length - 1]) || expr === '') {\nexpr += v;\n} else {\nexpr = expr.slice(0, -1) + v;\n}\ndisplay.value = expr;\n}\nfunction safeEvaluate(input) {\nif (input === '' || isOperator(input[input.length - 1])) return 'Error';\nvar tokens = [];\nvar num = '';\nfor (var i = 0; i < input.length; i++) {\nvar c = input[i];\nif (isOperator(c)) {\nif (num === '') return 'Error';\ntokens.push(parseFloat(num));\ntokens.push(c);\nnum = '';\n} else if (c >= '0' && c <= '9' || c === '.') {\nnum += c;\n} else {\nreturn 'Error';\n}\n}\nif (num === '') return 'Error';\ntokens.push(parseFloat(num));\nfor (var j = 0; j < tokens.length; j++) {\nif (tokens[j] === '*' || tokens[j] === '/') {\nvar left = tokens[j - 1];\nvar right = tokens[j + 1];\nif (tokens[j] === '/' && right === 0) return 'Error';\nvar res = tokens[j] === '*' ? left * right : left / right;\ntokens.splice(j - 1, 3, res);\nj--;\n}\n}\nfor (var k = 0; k < tokens.length; k++) {\nif (tokens[k] === '+' || tokens[k] === '-') {\nvar l = tokens[k - 1];\nvar r = tokens[k + 1];\nvar r2 = tokens[k] === '+' ? l + r : l - r;\ntokens.splice(k - 1, 3, r2);\nk--;\n}\n}\nreturn String(tokens[0]);\n}\nvar buttons = document.querySelectorAll('button');\nfor (var b = 0; b < buttons.length; b++) {\nbuttons[b].addEventListener('click', function() {\nappendValue(this.getAttribute('data-value'));\n});\n}\n})();\n</script>\n</body>\n</html>",
      "command": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Calculator</title>\n<style>\n* { box-sizing: border-box; margin: 0; padding: 0; }\nbody {\nmin-height: 100vh;\ndisplay: flex;\nalign-items: center;\njustify-content: center;\nbackground: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\nfont-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n}\n.calculator {\nbackground: rgba(255, 255, 255, 0.1);\nbackdrop-filter: blur(10px);\nborder-radius: 20px;\npadding: 20px;\nbox-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);\nwidth: 320px;\n}\n.display {\nwidth: 100%;\nheight: 60px;\nborder: none;\nborder-radius: 12px;\nbackground: rgba(0, 0, 0, 0.25);\ncolor: #fff;\nfont-size: 28px;\ntext-align: right;\npadding: 10px 15px;\nmargin-bottom: 15px;\noverflow: hidden;\n}\n.buttons {\ndisplay: grid;\ngrid-template-columns: repeat(4, 1fr);\ngap: 10px;\n}\nbutton {\nheight: 55px;\nborder: none;\nborder-radius: 12px;\nfont-size: 20px;\nfont-weight: 600;\ncursor: pointer;\nbackground: rgba(255, 255, 255, 0.85);\ncolor: #333;\ntransition: transform 0.1s, background 0.2s;\n}\nbutton:hover { background: #fff; transform: translateY(-2px); }\nbutton:active { transform: translateY(0); }\n.operator { background: linear-gradient(135deg, #f093fb, #f5576c); color: #fff; }\n.operator:hover { background: linear-gradient(135deg, #f5576c, #f093fb); }\n.clear { background: linear-gradient(135deg, #ffd86f, #fc6262); color: #fff; }\n.equals { background: linear-gradient(135deg, #43e97b, #38f9d7); color: #333; grid-column: span 2; }\n.zero { grid-column: span 2; }\n</style>\n</head>\n<body>\n<div class=\"calculator\">\n<input type=\"text\" class=\"display\" id=\"display\" value=\"0\" readonly>\n<div class=\"buttons\">\n<button class=\"clear\" data-value=\"C\">C</button>\n<button class=\"operator\" data-value=\"/\">/</button>\n<button class=\"operator\" data-value=\"*\">*</button>\n<button class=\"operator\" data-value=\"-\">-</button>\n<button data-value=\"7\">7</button>\n<button data-value=\"8\">8</button>\n<button data-value=\"9\">9</button>\n<button class=\"operator\" data-value=\"+\">+</button>\n<button data-value=\"4\">4</button>\n<button data-value=\"5\">5</button>\n<button data-value=\"6\">6</button>\n<button data-value=\"1\">1</button>\n<button data-value=\"2\">2</button>\n<button data-value=\"3\">3</button>\n<button data-value=\"0\" class=\"zero\">0</button>\n<button data-value=\".\">.</button>\n<button class=\"equals\" data-value=\"=\">=</button>\n</div>\n</div>\n<script>\n(function() {\nvar display = document.getElementById('display');\nvar expr = '';\nfunction isOperator(ch) {\nreturn ch === '+' || ch === '-' || ch === '*' || ch === '/';\n}\nfunction appendValue(v) {\nif (v === 'C') {\nexpr = '';\ndisplay.value = '0';\nreturn;\n}\nif (v === '=') {\nvar result = safeEvaluate(expr);\ndisplay.value = result;\nexpr = (result === 'Error') ? '' : String(result);\nreturn;\n}\nif (isOperator(v)) {\nif (expr === '' && v !== '-') return;\nif (expr !== '' && isOperator(expr[expr.length - 1])) {\nexpr = expr.slice(0, -1) + v;\ndisplay.value = expr;\nreturn;\n}\nexpr += v;\ndisplay.value = expr;\nreturn;\n}\nif (v === '.') {\nvar parts = expr.split(/[\\+\\-\\*\\/]/);\nvar last = parts[parts.length - 1];\nif (last === '' || last.indexOf('.') !== -1) return;\nif (expr === '' || isOperator(expr[expr.length - 1])) {\nexpr += '0.';\n} else {\nexpr += '.';\n}\ndisplay.value = expr;\nreturn;\n}\nif (expr === '' || expr === '0') {\nexpr = v;\ndisplay.value = expr;\nreturn;\n}\nvar seg = expr.split(/[\\+\\-\\*\\/]/);\nvar cur = seg[seg.length - 1];\nif (cur !== '0' || isOperator(expr[expr.length - 1])) {\nexpr += v;\n} else if (isOperator(expr[expr.length - 1]) || expr === '') {\nexpr += v;\n} else {\nexpr = expr.slice(0, -1) + v;\n}\ndisplay.value = expr;\n}\nfunction safeEvaluate(input) {\nif (input === '' || isOperator(input[input.length - 1])) return 'Error';\nvar tokens = [];\nvar num = '';\nfor (var i = 0; i < input.length; i++) {\nvar c = input[i];\nif (isOperator(c)) {\nif (num === '') return 'Error';\ntokens.push(parseFloat(num));\ntokens.push(c);\nnum = '';\n} else if (c >= '0' && c <= '9' || c === '.') {\nnum += c;\n} else {\nreturn 'Error';\n}\n}\nif (num === '') return 'Error';\ntokens.push(parseFloat(num));\nfor (var j = 0; j < tokens.length; j++) {\nif (tokens[j] === '*' || tokens[j] === '/') {\nvar left = tokens[j - 1];\nvar right = tokens[j + 1];\nif (tokens[j] === '/' && right === 0) return 'Error';\nvar res = tokens[j] === '*' ? left * right : left / right;\ntokens.splice(j - 1, 3, res);\nj--;\n}\n}\nfor (var k = 0; k < tokens.length; k++) {\nif (tokens[k] === '+' || tokens[k] === '-') {\nvar l = tokens[k - 1];\nvar r = tokens[k + 1];\nvar r2 = tokens[k] === '+' ? l + r : l - r;\ntokens.splice(k - 1, 3, r2);\nk--;\n}\n}\nreturn String(tokens[0]);\n}\nvar buttons = document.querySelectorAll('button');\nfor (var b = 0; b < buttons.length; b++) {\nbuttons[b].addEventListener('click', function() {\nappendValue(this.getAttribute('data-value'));\n});\n}\n})();\n</script>\n</body>\n</html>",
