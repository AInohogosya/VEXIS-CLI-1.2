      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Calculator</title>\n<style>\nbody {\nmargin: 0;\nmin-height: 100vh;\ndisplay: flex;\nalign-items: center;\njustify-content: center;\nbackground: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\nfont-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n}\n.calculator {\nbackground: rgba(255, 255, 255, 0.1);\nbackdrop-filter: blur(10px);\nborder-radius: 20px;\npadding: 20px;\nbox-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);\nwidth: 280px;\n}\n.display {\nbackground: rgba(0, 0, 0, 0.25);\ncolor: #fff;\nfont-size: 2rem;\ntext-align: right;\npadding: 15px;\nborder-radius: 10px;\nmargin-bottom: 15px;\noverflow: hidden;\nmin-height: 2.5rem;\nword-break: break-all;\n}\n.buttons {\ndisplay: grid;\ngrid-template-columns: repeat(4, 1fr);\ngap: 10px;\n}\nbutton {\nborder: none;\nborder-radius: 10px;\npadding: 18px 0;\nfont-size: 1.2rem;\ncolor: #fff;\nbackground: linear-gradient(145deg, #ff6a88, #ff99ac);\ncursor: pointer;\ntransition: transform 0.1s, box-shadow 0.1s;\nbox-shadow: 0 4px 10px rgba(0,0,0,0.2);\n}\nbutton:active {\ntransform: scale(0.95);\nbox-shadow: 0 2px 5px rgba(0,0,0,0.3);\n}\nbutton.operator {\nbackground: linear-gradient(145deg, #4facfe, #00f2fe);\n}\nbutton.clear {\nbackground: linear-gradient(145deg, #f83600, #f9d423);\n}\nbutton.equals {\nbackground: linear-gradient(145deg, #43e97b, #38f9d7);\ncolor: #000;\n}\n</style>\n</head>\n<body>\n<div class=\"calculator\">\n<div class=\"display\" id=\"display\">0</div>\n<div class=\"buttons\">\n<button class=\"clear\" data-value=\"C\">C</button>\n<button class=\"operator\" data-value=\"/\">/</button>\n<button class=\"operator\" data-value=\"*\">*</button>\n<button class=\"operator\" data-value=\"-\">-</button>\n<button data-value=\"7\">7</button>\n<button data-value=\"8\">8</button>\n<button data-value=\"9\">9</button>\n<button class=\"operator\" data-value=\"+\">+</button>\n<button data-value=\"4\">4</button>\n<button data-value=\"5\">5</button>\n<button data-value=\"6\">6</button>\n<button data-value=\"1\">1</button>\n<button data-value=\"2\">2</button>\n<button data-value=\"3\">3</button>\n<button data-value=\"0\">0</button>\n<button data-value=\".\">.</button>\n<button class=\"equals\" data-value=\"=\">=</button>\n</div>\n</div>\n<script>\n(function() {\nvar display = document.getElementById('display');\nvar current = '0';\nvar justEvaluated = false;\nfunction updateDisplay() {\ndisplay.textContent = current;\n}\nfunction isOperator(ch) {\nreturn ch === '+' || ch === '-' || ch === '*' || ch === '/';\n}\n// Safe expression evaluator: no eval / Function\nfunction safeEvaluate(expr) {\nvar tokens = [];\nvar num = '';\nfor (var i = 0; i < expr.length; i++) {\nvar ch = expr[i];\nif (isOperator(ch)) {\nif (num === '') return 'Error';\ntokens.push(parseFloat(num));\ntokens.push(ch);\nnum = '';\n} else if (ch >= '0' && ch <= '9' || ch === '.') {\nnum += ch;\n} else {\nreturn 'Error';\n}\n}\nif (num === '') return 'Error';\ntokens.push(parseFloat(num));\n// First pass: * and /\nvar reduced = [];\nvar i = 0;\nwhile (i < tokens.length) {\nif (typeof tokens[i] === 'number') {\nreduced.push(tokens[i]);\ni++;\n} else {\nvar op = tokens[i];\nvar left = reduced.pop();\nvar right = tokens[i + 1];\nif (typeof right !== 'number') return 'Error';\nif (op === '*') reduced.push(left * right);\nelse if (op === '/') {\nif (right === 0) return 'Error';\nreduced.push(left / right);\n}\ni += 2;\n}\n}\n// Second pass: + and -\nvar result = reduced[0];\nfor (var j = 1; j < reduced.length; j += 2) {\nvar oper = reduced[j];\nvar val = reduced[j + 1];\nif (oper === '+') result += val;\nelse if (oper === '-') result -= val;\nelse return 'Error';\n}\nreturn result;\n}\nfunction handleInput(val) {\nif (val === 'C') {\ncurrent = '0';\njustEvaluated = false;\nupdateDisplay();\nreturn;\n}\nif (val === '=') {\nvar res = safeEvaluate(current);\nif (res === 'Error') {\ncurrent = 'Error';\n} else {\ncurrent = String(res);\n}\njustEvaluated = true;\nupdateDisplay();\nreturn;\n}\nif (justEvaluated) {\nif (isOperator(val)) {\njustEvaluated = false;\n} else if (val === '.') {\ncurrent = '0.';\njustEvaluated = false;\nupdateDisplay();\nreturn;\n} else {\ncurrent = '0';\njustEvaluated = false;\n}\n}\nif (isOperator(val)) {\nif (current === 'Error') return;\nvar last = current[current.length - 1];\nif (isOperator(last)) {\ncurrent = current.slice(0, -1) + val;\n} else {\ncurrent += val;\n}\nupdateDisplay();\nreturn;\n}\nif (val === '.') {\nif (current === 'Error') return;\nvar parts = current.split(/[\\+\\-\\*\\/]/);\nvar lastPart = parts[parts.length - 1];\nif (lastPart.indexOf('.') !== -1) return;\nif (isOperator(current[current.length - 1]) || current === '0') {\ncurrent += '0.';\n} else {\ncurrent += '.';\n}\nupdateDisplay();\nreturn;\n}\n// digit\nif (current === 'Error') return;\nif (current === '0') {\ncurrent = val;\n} else {\nvar lastChar = current[current.length - 1];\nvar seg = current.split(/[\\+\\-\\*\\/]/);\nvar curSeg = seg[seg.length - 1];\nif (isOperator(lastChar)) {\ncurrent += val;\n} else if (curSeg === '0') {\ncurrent = current.slice(0, -1) + val;\n} else {\ncurrent += val;\n}\n}\nupdateDisplay();\n}\nvar buttons = document.querySelectorAll('button');\nbuttons.forEach(function(btn) {\nbtn.addEventListener('click', function() {\nhandleInput(btn.getAttribute('data-value'));\n});\n});\nupdateDisplay();\n})();\n</script>\n</body>\n</html>",
      "command": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Calculator</title>\n<style>\nbody {\nmargin: 0;\nmin-height: 100vh;\ndisplay: flex;\nalign-items: center;\njustify-content: center;\nbackground: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\nfont-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n}\n.calculator {\nbackground: rgba(255, 255, 255, 0.1);\nbackdrop-filter: blur(10px);\nborder-radius: 20px;\npadding: 20px;\nbox-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);\nwidth: 280px;\n}\n.display {\nbackground: rgba(0, 0, 0, 0.25);\ncolor: #fff;\nfont-size: 2rem;\ntext-align: right;\npadding: 15px;\nborder-radius: 10px;\nmargin-bottom: 15px;\noverflow: hidden;\nmin-height: 2.5rem;\nword-break: break-all;\n}\n.buttons {\ndisplay: grid;\ngrid-template-columns: repeat(4, 1fr);\ngap: 10px;\n}\nbutton {\nborder: none;\nborder-radius: 10px;\npadding: 18px 0;\nfont-size: 1.2rem;\ncolor: #fff;\nbackground: linear-gradient(145deg, #ff6a88, #ff99ac);\ncursor: pointer;\ntransition: transform 0.1s, box-shadow 0.1s;\nbox-shadow: 0 4px 10px rgba(0,0,0,0.2);\n}\nbutton:active {\ntransform: scale(0.95);\nbox-shadow: 0 2px 5px rgba(0,0,0,0.3);\n}\nbutton.operator {\nbackground: linear-gradient(145deg, #4facfe, #00f2fe);\n}\nbutton.clear {\nbackground: linear-gradient(145deg, #f83600, #f9d423);\n}\nbutton.equals {\nbackground: linear-gradient(145deg, #43e97b, #38f9d7);\ncolor: #000;\n}\n</style>\n</head>\n<body>\n<div class=\"calculator\">\n<div class=\"display\" id=\"display\">0</div>\n<div class=\"buttons\">\n<button class=\"clear\" data-value=\"C\">C</button>\n<button class=\"operator\" data-value=\"/\">/</button>\n<button class=\"operator\" data-value=\"*\">*</button>\n<button class=\"operator\" data-value=\"-\">-</button>\n<button data-value=\"7\">7</button>\n<button data-value=\"8\">8</button>\n<button data-value=\"9\">9</button>\n<button class=\"operator\" data-value=\"+\">+</button>\n<button data-value=\"4\">4</button>\n<button data-value=\"5\">5</button>\n<button data-value=\"6\">6</button>\n<button data-value=\"1\">1</button>\n<button data-value=\"2\">2</button>\n<button data-value=\"3\">3</button>\n<button data-value=\"0\">0</button>\n<button data-value=\".\">.</button>\n<button class=\"equals\" data-value=\"=\">=</button>\n</div>\n</div>\n<script>\n(function() {\nvar display = document.getElementById('display');\nvar current = '0';\nvar justEvaluated = false;\nfunction updateDisplay() {\ndisplay.textContent = current;\n}\nfunction isOperator(ch) {\nreturn ch === '+' || ch === '-' || ch === '*' || ch === '/';\n}\n// Safe expression evaluator: no eval / Function\nfunction safeEvaluate(expr) {\nvar tokens = [];\nvar num = '';\nfor (var i = 0; i < expr.length; i++) {\nvar ch = expr[i];\nif (isOperator(ch)) {\nif (num === '') return 'Error';\ntokens.push(parseFloat(num));\ntokens.push(ch);\nnum = '';\n} else if (ch >= '0' && ch <= '9' || ch === '.') {\nnum += ch;\n} else {\nreturn 'Error';\n}\n}\nif (num === '') return 'Error';\ntokens.push(parseFloat(num));\n// First pass: * and /\nvar reduced = [];\nvar i = 0;\nwhile (i < tokens.length) {\nif (typeof tokens[i] === 'number') {\nreduced.push(tokens[i]);\ni++;\n} else {\nvar op = tokens[i];\nvar left = reduced.pop();\nvar right = tokens[i + 1];\nif (typeof right !== 'number') return 'Error';\nif (op === '*') reduced.push(left * right);\nelse if (op === '/') {\nif (right === 0) return 'Error';\nreduced.push(left / right);\n}\ni += 2;\n}\n}\n// Second pass: + and -\nvar result = reduced[0];\nfor (var j = 1; j < reduced.length; j += 2) {\nvar oper = reduced[j];\nvar val = reduced[j + 1];\nif (oper === '+') result += val;\nelse if (oper === '-') result -= val;\nelse return 'Error';\n}\nreturn result;\n}\nfunction handleInput(val) {\nif (val === 'C') {\ncurrent = '0';\njustEvaluated = false;\nupdateDisplay();\nreturn;\n}\nif (val === '=') {\nvar res = safeEvaluate(current);\nif (res === 'Error') {\ncurrent = 'Error';\n} else {\ncurrent = String(res);\n}\njustEvaluated = true;\nupdateDisplay();\nreturn;\n}\nif (justEvaluated) {\nif (isOperator(val)) {\njustEvaluated = false;\n} else if (val === '.') {\ncurrent = '0.';\njustEvaluated = false;\nupdateDisplay();\nreturn;\n} else {\ncurrent = '0';\njustEvaluated = false;\n}\n}\nif (isOperator(val)) {\nif (current === 'Error') return;\nvar last = current[current.length - 1];\nif (isOperator(last)) {\ncurrent = current.slice(0, -1) + val;\n} else {\ncurrent += val;\n}\nupdateDisplay();\nreturn;\n}\nif (val === '.') {\nif (current === 'Error') return;\nvar parts = current.split(/[\\+\\-\\*\\/]/);\nvar lastPart = parts[parts.length - 1];\nif (lastPart.indexOf('.') !== -1) return;\nif (isOperator(current[current.length - 1]) || current === '0') {\ncurrent += '0.';\n} else {\ncurrent += '.';\n}\nupdateDisplay();\nreturn;\n}\n// digit\nif (current === 'Error') return;\nif (current === '0') {\ncurrent = val;\n} else {\nvar lastChar = current[current.length - 1];\nvar seg = current.split(/[\\+\\-\\*\\/]/);\nvar curSeg = seg[seg.length - 1];\nif (isOperator(lastChar)) {\ncurrent += val;\n} else if (curSeg === '0') {\ncurrent = current.slice(0, -1) + val;\n} else {\ncurrent += val;\n}\n}\nupdateDisplay();\n}\nvar buttons = document.querySelectorAll('button');\nbuttons.forEach(function(btn) {\nbtn.addEventListener('click', function() {\nhandleInput(btn.getAttribute('data-value'));\n});\n});\nupdateDisplay();\n})();\n</script>\n</body>\n</html>",
